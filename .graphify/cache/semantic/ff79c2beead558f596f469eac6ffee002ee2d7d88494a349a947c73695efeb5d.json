{"nodes": [{"id": "design_pii_dnat_hardening", "label": "PII Proxy + microVM DNAT Hardening Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-05-08-pii-microvm-dnat-hardening-design.md", "source_location": null, "source_url": null, "captured_at": "2026-05-08", "author": null, "contributor": null}, {"id": "design_pii_dnat_preflight", "label": "_pii_dnat_preflight()", "file_type": "code", "source_file": "docs/superpowers/specs/2026-05-08-pii-microvm-dnat-hardening-design.md", "source_location": "lib/sandbox/microvm.sh", "source_url": null, "captured_at": "2026-05-08", "author": null, "contributor": null}, {"id": "design_pii_dnat_sweep_stale", "label": "_pii_dnat_sweep_stale()", "file_type": "code", "source_file": "docs/superpowers/specs/2026-05-08-pii-microvm-dnat-hardening-design.md", "source_location": "lib/sandbox/microvm.sh", "source_url": null, "captured_at": "2026-05-08", "author": null, "contributor": null}, {"id": "design_iptables_comment_marker", "label": "iptables comment marker (iclaude-pii-dnat:<tap>)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-08-pii-microvm-dnat-hardening-design.md", "source_location": null, "source_url": null, "captured_at": "2026-05-08", "author": null, "contributor": null, "rationale": "Stable identifier requiring no external state file (no PID, no port). The iptables comment module is part of universal Linux kernel iptables build."}, {"id": "design_problem_p1", "label": "P1: Silent failure when passwordless sudo unavailable", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-08-pii-microvm-dnat-hardening-design.md", "source_location": null, "source_url": null, "captured_at": "2026-05-08", "author": null, "contributor": null, "rationale": "Current code gates DNAT block via sudo -n true; if unavailable, block is skipped silently. Guest cannot reach proxy and failure surfaces as opaque network error inside Claude Code."}, {"id": "design_problem_p2", "label": "P2: Stale iptables rules after crash", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-08-pii-microvm-dnat-hardening-design.md", "source_location": null, "source_url": null, "captured_at": "2026-05-08", "author": null, "contributor": null, "rationale": "If stop_microvm() does not run (SIGKILL, OOM, host panic), DNAT/INPUT rules persist and accumulate across sessions, unidentifiable without external state."}, {"id": "design_problem_p5", "label": "P5: route_localnet=1 not reset", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-08-pii-microvm-dnat-hardening-design.md", "source_location": null, "source_url": null, "captured_at": "2026-05-08", "author": null, "contributor": null, "rationale": "Sysctl persists on the TAP iface; if statically provisioned, the setting leaks. Low risk, cheap to fix."}, {"id": "design_test_l1_unit", "label": "L1 mock unit tests", "file_type": "document", "source_file": "docs/superpowers/specs/2026-05-08-pii-microvm-dnat-hardening-design.md", "source_location": "tests/test_pii_dnat_unit.sh", "source_url": null, "captured_at": "2026-05-08", "author": null, "contributor": null}, {"id": "design_test_l2_iptables", "label": "L2 real iptables tests on dummy iface", "file_type": "document", "source_file": "docs/superpowers/specs/2026-05-08-pii-microvm-dnat-hardening-design.md", "source_location": "tests/test_pii_dnat_iptables.sh", "source_url": null, "captured_at": "2026-05-08", "author": null, "contributor": null}, {"id": "design_test_l3_e2e", "label": "L3 full E2E test (KVM + sudo + firecracker)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-05-08-pii-microvm-dnat-hardening-design.md", "source_location": "tests/test_pii_dnat_e2e.sh", "source_url": null, "captured_at": "2026-05-08", "author": null, "contributor": null}], "edges": [{"source": "design_pii_dnat_hardening", "target": "design_problem_p1", "relation": "addresses", "confidence": "EXTRACTED", "confidence_score": 1