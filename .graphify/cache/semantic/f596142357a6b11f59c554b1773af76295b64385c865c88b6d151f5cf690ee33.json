lace them with symlinks pointing to ~/.ssh/id_rsa. safeWriteFlag uses O_NOFOLLOW, atomic temp+rename, 0600 permissions, and ownership checks on symlinked parent dirs to prevent symlink clobber attacks. readFlag enforces same protections plus a 64-byte size cap to prevent exfil of secret files via flag readers."}], "edges": [{"source": "cavemanconfig_symlinksafety", "target": "cavemanconfig_safewriteflag", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".nvm-isolated/.claude-isolated/hooks/caveman-config.js", "source_location": "line 81", "weight": 1.0}, {"source": "cavemanconfig_symlinksafety", "target": "cavemanconfig_readflag", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".nvm-isolated/.claude-isolated/hooks/caveman-config.js", "source_location": "line 160", "weight": 1.0}], "hyperedges": [{"id": "caveman_flag_lifecycle", "label": "Caveman Flag Read-Write Lifecycle", "nodes": ["cavemanconfig_safewriteflag", "cavemanconfig_readflag", "cavemanconfig_appendflag"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": ".nvm-isolated/.claude-isolated/hooks/caveman-config.js"}]}