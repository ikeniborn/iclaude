{
  "$comment": "Conventional Commits types. Branch naming is not derived from the type: branches are always dev-<topic> (see git-workflow/SKILL.md).",
  "types": {
    "feat": {
      "description": "New feature",
      "emoji": "✨"
    },
    "fix": {
      "description": "Bug fix",
      "emoji": "🐛"
    },
    "refactor": {
      "description": "Code refactoring without changing functionality",
      "emoji": "♻️"
    },
    "docs": {
      "description": "Documentation only",
      "emoji": "📚"
    },
    "test": {
      "description": "Adding or fixing tests",
      "emoji": "🧪"
    },
    "chore": {
      "description": "Maintenance, CI/CD, dependencies",
      "emoji": "🔧"
    },
    "perf": {
      "description": "Performance improvement",
      "emoji": "⚡"
    },
    "style": {
      "description": "Code style changes (formatting, whitespace)",
      "emoji": "💄"
    }
  },
  "format": {
    "subject_max_length": 72,
    "body_wrap": 100,
    "footer": "Co-Authored-By: <the co-author line the harness specifies>"
  }
}
