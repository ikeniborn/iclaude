# .claude_config.example — шаблон конфигурации iclaude
#
# Использование:
#   cp .claude_config.example .claude_config
#   # Отредактировать .claude_config, заполнить нужные значения
#
# ВАЖНО: .claude_config добавлен в .gitignore — не коммитить!
# Файл содержит секреты: пароли прокси, API ключи.
#
# Файл автоматически загружается при запуске ./iclaude.sh
# Все переменные становятся доступны в окружении Claude Code.
#
# Формат: bash-переменные с префиксом ICLAUDE_ (ICLAUDE_KEY=value), без export.
# Слой трансляции (lib/config/env-map.sh) снимает префикс и экспортирует
# каноническое имя, которое читают встроенные инструменты.
# Старый .claude_config (без префикса / с export) мигрируется автоматически
# при первом запуске (создаётся резервная копия .claude_config.bak).
# Пустые значения (KEY=) — переменная игнорируется.

# ============================================================
#  ПРОКСИ-СЕРВЕР
# ============================================================
# Адрес прокси-сервера.
# Форматы:
#   https://host:port                    — без аутентификации
#   https://[CREDENTIALS]@host:port      — с логином/паролем
#   http://[CREDENTIALS]@host:port       — HTTP прокси (хуже для OAuth)
#
# HTTPS прокси рекомендуется: сохраняет доменные имена для OAuth/TLS.
# HTTP прокси не рекомендуется: проблемы с TLS-сертификатами Anthropic.
# SOCKS5 не поддерживается: вызывает сбой в undici (Node.js HTTP-клиент).
#
# По умолчанию: не задан (прокси не используется).
# Устанавливается через: ./iclaude.sh --proxy https://[CREDENTIALS]@proxy:8118
ICLAUDE_PROXY_URL=

# Отключить проверку TLS-сертификата прокси-сервера.
# true  — отключить (небезопасно, используйте только в крайнем случае)
# false — включить (по умолчанию)
#
# Альтернатива: PROXY_CA (безопасный способ)
ICLAUDE_PROXY_INSECURE=false

# Путь к CA-сертификату прокси-сервера (PEM-формат).
# Используется, когда прокси перехватывает HTTPS (corporate MITM proxy).
# Пример: /etc/ssl/certs/my-corp-ca.pem
#
# По умолчанию: не задан (дополнительный CA-сертификат не устанавливается).
# Если задан, устанавливает NODE_EXTRA_CA_CERTS автоматически.
# Предпочтительнее PROXY_INSECURE=true.
ICLAUDE_PROXY_CA=

# Список хостов, которые должны обходить прокси (через запятую).
# Значение по умолчанию (если не задано):
#   localhost,127.0.0.1,::1,github.com,githubusercontent.com,
#   gitlab.com,bitbucket.org,registry.npmjs.org,nodejs.org
#
# Добавьте внутренние хосты, которые не должны идти через прокси.
ICLAUDE_NO_PROXY=

# ============================================================
#  МОДЕЛЬ CLAUDE CODE
# ============================================================
# Принудительно задать модель Claude Code (переопределяет настройки по умолчанию).
#
# Используется при запуске без роутера (нативный Claude API).
# При запуске с роутером (--router) модель задаётся в router.json.
# По умолчанию (если не задан): claude-sonnet-4-6
#
# Устанавливается через: ./iclaude.sh --model claude-sonnet-4-6
ICLAUDE_CLAUDE_CODE_MODEL=

# Нативная переменная Claude Code для выбора модели по умолчанию.
# Альтернатива CLAUDE_CODE_MODEL: читается напрямую Claude Code (без флага --model).
# Если задан и CLAUDE_CODE_MODEL — флаг --model имеет приоритет.
# По умолчанию (если не задан): claude-sonnet-4-6
# Пример: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5-20251001
ICLAUDE_ANTHROPIC_MODEL=

# Переопределить alias-маппинг семейств моделей (opus/sonnet/haiku → конкретная версия).
# Полезно для закрепления точной версии модели без изменения конфигов роутера.
# По умолчанию: последняя версия соответствующего семейства.
ICLAUDE_ANTHROPIC_DEFAULT_OPUS_MODEL=   # По умолчанию: claude-opus-4-6
ICLAUDE_ANTHROPIC_DEFAULT_SONNET_MODEL= # По умолчанию: claude-sonnet-4-6
ICLAUDE_ANTHROPIC_DEFAULT_HAIKU_MODEL=  # По умолчанию: claude-haiku-4-5-20251001

# ============================================================
#  НАСТРОЙКИ CLAUDE CODE
# ============================================================
# Максимальное количество токенов в ответе.
# По умолчанию: зависит от модели (обычно 8192 или 32768).
# Увеличьте для длинных генераций кода.
ICLAUDE_CLAUDE_CODE_MAX_OUTPUT_TOKENS=

# Включить систему задач (Tasks).
# true  — включить (по умолчанию в iclaude)
# false — отключить (использовать только если Tasks вызывают проблемы)
#
# Tasks позволяют создавать списки задач (TaskCreate/TaskUpdate/TaskList)
# и отслеживать прогресс в интерактивном режиме.
ICLAUDE_CLAUDE_CODE_ENABLE_TASKS=true

# Отключить интеграцию с Chrome.
# true  — отключить Chrome-инструменты (mcp__claude-in-chrome__*)
# false — включить (по умолчанию)
#
# Отключается через: ./iclaude.sh --no-chrome
ICLAUDE_CLAUDE_CODE_NO_CHROME=

# Таймаут сессии в секундах.
# По умолчанию: не задан (используется таймаут Claude Code по умолчанию).
ICLAUDE_CLAUDE_CODE_SESSION_TIMEOUT=

# Экспериментальная поддержка команд агентов (Agent Teams).
# true  — включить (нестабильно, экспериментально)
# false — отключить (по умолчанию)
ICLAUDE_CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=

# Отдельная модель для субагентов (Task tool, параллельные агенты).
# По умолчанию: Haiku (быстрый и дешёвый для фоновых подзадач).
# Пример: claude-sonnet-4-6 — если субагентам нужно более высокое качество.
ICLAUDE_CLAUDE_CODE_SUBAGENT_MODEL=

# Уровень усилий Claude Code (влияет на extended thinking и глубину анализа).
# low    — быстро, меньше thinking
# medium — баланс скорости и качества (по умолчанию)
# high   — максимальное качество, больше thinking (дороже)
ICLAUDE_CLAUDE_CODE_EFFORT_LEVEL=

# Отключить extended thinking (adaptive thinking) у Opus/Sonnet 4.6.
# 1 — отключить (ускоряет ответы, снижает стоимость, отключает глубокий анализ)
# (оставить пустым — adaptive thinking включён по умолчанию)
ICLAUDE_CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING=

# Отключить расширенный контекст (200K context window).
# 1 — использовать стандартный контекст модели
# По умолчанию: не задан (расширенный контекст активен)
ICLAUDE_CLAUDE_CODE_DISABLE_1M_CONTEXT=

# Отключить экспериментальные API-фичи (beta endpoints).
# 1 — только стабильные API (рекомендуется для production-сред)
# По умолчанию: не задан (experimental betas включены)
ICLAUDE_CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=

# Разрешить Claude Code пропускать подтверждение опасных операций (bypass permissions).
# true  — передаёт --dangerously-skip-permissions при запуске (аналог флага --no-save)
# false — безопасный режим (по умолчанию, подтверждение требуется)
#
# ВАЖНО: включайте только в автоматизированных/доверенных средах.
# Флаг --no-save в командной строке всегда имеет приоритет над этой переменной.
ICLAUDE_CLAUDE_CODE_SKIP_PERMISSIONS=false

# ============================================================
#  ЯЗЫК ОБЩЕНИЯ И ДОКУМЕНТАЦИИ
# ============================================================
# Читаются хуками caveman (caveman-activate.js / caveman-mode-tracker.js) и
# подставляются в правило режима, чтобы сжатие не уводило ответы в английский.
#
# Язык общения и ответов. Если не задан — берётся из settings.json "language",
# иначе общий принцип «язык пользователя». Держите в синхроне с settings.json "language".
# Пример: Russian, English, Español
ICLAUDE_CHAT_LANG=

# Язык документации, комментариев в коде, коммитов и PR.
# По умолчанию (если не задан): English.
# Пример: English, Russian
ICLAUDE_DOC_LANG=

# ============================================================
#  OAUTH ТОКЕН
# ============================================================
# OAuth токен для аутентификации Claude Code.
# Получается после авторизации: claude login → "Store this token securely"
# или через: claude setup-token
#
# Если задан — используется вместо .credentials.json для аутентификации.
# Полезно когда .credentials.json недоступен или для headless-серверов.
#
# Формат: sk-ant-oat01-... (OAuth subscription token)
# По умолчанию: не задан (используется .credentials.json)
ICLAUDE_CLAUDE_CODE_OAUTH_TOKEN=

# Порог автоматического обновления OAuth токена (в секундах).
# Если до истечения токена осталось меньше этого значения — токен обновляется при запуске.
#
# По умолчанию: 604800 (7 дней)
# Минимальное рекомендуемое значение: 86400 (1 день)
# Максимальное разумное значение: 2592000 (30 дней)
#
# Примеры:
#   ICLAUDE_TOKEN_REFRESH_THRESHOLD=604800    # 7 дней  (по умолчанию)
#   ICLAUDE_TOKEN_REFRESH_THRESHOLD=86400     # 1 день  (обновлять позже)
#   ICLAUDE_TOKEN_REFRESH_THRESHOLD=1209600   # 14 дней (обновлять раньше)
#
# Токен действует ~1 год. Ручное обновление: ./iclaude.sh --refresh-token
# ICLAUDE_TOKEN_REFRESH_THRESHOLD=

# ============================================================
#  ROUTER: API-КЛЮЧИ LLM-ПРОВАЙДЕРОВ
# ============================================================
# Используются в router.json через плейсхолдеры ${VAR_NAME}.
# Пример в router.json: "api_key": "${DEEPSEEK_API_KEY}"
#
# Для активации роутера: ./iclaude.sh --router
# Конфиг роутера: .nvm-isolated/.claude-isolated/router.json
# Шаблон конфига: .nvm-isolated/.claude-isolated/router.json.example
#
# В дефолтном router.json.example используются: DeepSeek, OpenRouter, Google.
# Groq, Volcengine, SiliconFlow — для кастомных конфигураций роутера.

# --- Anthropic API key (для роутинга через CCR) ---
# Нужен при роутинге через CCR к Anthropic (--router + Anthropic в router.json).
# В нативном режиме (без --router) Claude Code использует OAuth из .credentials.json — API ключ не нужен.
# ВАЖНО: OAuth токен подписки (sk-ant-oat01-...) НЕ принимается api.anthropic.com.
#   CCR требует обычный API ключ. Без него используйте Ollama/DeepSeek/OpenRouter.
# Получить ключ: https://console.anthropic.com/settings/keys
# Формат: [API_KEY_REDACTED]
ICLAUDE_ANTHROPIC_API_KEY=

# --- DeepSeek ---
# Используется в router.json.example (провайдер по умолчанию)
# Получить ключ: https://platform.deepseek.com/api_keys
# Формат: [API_KEY_REDACTED]
ICLAUDE_DEEPSEEK_API_KEY=

# --- OpenRouter ---
# Агрегатор: 300+ моделей через единый API (GPT, Gemini, Llama, Mistral и др.)
# Используется в router.json.example
# По умолчанию: не задан (провайдер не используется без ключа)
# Получить ключ: https://openrouter.ai/keys
# Формат: [API_KEY_REDACTED]
ICLAUDE_OPENROUTER_API_KEY=

# --- Google Gemini ---
# Используется в router.json.example (gemini-2.5-pro для длинного контекста)
# По умолчанию: не задан (провайдер не используется без ключа)
# Получить ключ: https://aistudio.google.com/app/apikey
# Формат: [GOOGLE_API_KEY]
ICLAUDE_GOOGLE_API_KEY=

# --- Groq (опционально) ---
# Сверхбыстрый inference на специализированном железе (LPU).
# Не включён в дефолтный router.json.example — добавьте вручную при необходимости.
# Получить ключ: https://console.groq.com/keys
# Формат: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ICLAUDE_GROQ_API_KEY=

# --- Volcengine (ByteDance, опционально) ---
# Облако ByteDance: модели Doubao-pro, Doubao-lite.
# Не включён в дефолтный router.json.example — добавьте вручную при необходимости.
# Получить ключ: https://console.volcengine.com/ark
ICLAUDE_VOLCENGINE_API_KEY=

# --- SiliconFlow (опционально) ---
# Китайская платформа: Qwen, DeepSeek, GLM через OpenAI-совместимый API.
# Не включён в дефолтный router.json.example — добавьте вручную при необходимости.
# Получить ключ: https://cloud.siliconflow.cn/account/ak
# Формат: [API_KEY_REDACTED]
ICLAUDE_SILICONFLOW_API_KEY=

# ============================================================
#  PII PROXY (маскирование PII/секретов в API-трафике)
# ============================================================
# Включить HTTP-прокси с Presidio NLP для перехвата /v1/messages.
# Маскирует PII и секреты в системном промпте, сообщениях и tool_results
# перед отправкой в Anthropic API.
#
# Требуется однократная установка: ./iclaude.sh --install-pii-proxy
# Статус: ./iclaude.sh --check-pii-proxy
#
# Режимы запуска (каждая сессия запускает собственный прокси-процесс):
#   solo:     --pii-proxy           → claude → PII proxy (авто-порт) → Anthropic API
#   combined: --pii-proxy --router  → claude → PII proxy (авто-порт) → CCR (:3456) → провайдеры
#
# Параллельные сессии iclaude не конфликтуют: каждая получает изолированный
# прокси-процесс на своём порту из диапазона PII_PROXY_PORT_MIN..PII_PROXY_PORT_MAX.
#
# true  — автозапуск прокси при каждом старте claude
# false — прокси не стартует (можно включить разово: --pii-proxy)
# По умолчанию: false
ICLAUDE_USE_PII_PROXY=false

# Уровень маскирования PII proxy.
# Управляет агрессивностью маскирования содержимого API-запросов:
#
#   off      — маскирование отключено; прокси работает, содержимое передаётся без изменений.
#              Используйте для отладки или если маскирование мешает работе.
#
#   secrets  — только регулярные выражения (API ключи, токены, пароли, URL с учётными данными).
#              Быстро, без NLP. Не обнаруживает имена, email, телефоны, адреса.
#              Рекомендуется для минимального overhead без потери защиты секретов.
#
#   standard — полное маскирование: Presidio NLP + регулярные выражения (по умолчанию).
#              Маскирует имена, email, телефоны, адреса, номера карт + все типы секретов.
#              Требует установленного Presidio; при отсутствии — fallback на режим secrets.
#
# По умолчанию: standard
# ICLAUDE_PII_PROXY_MASKING_LEVEL=standard

# Уровень логирования PII proxy:
#   info  — логировать только количество найденных элементов (по умолчанию, без PII-метаданных в логах)
#   debug — логировать количество + типы найденных сущностей (содержит PII-метаданные;
#           лог-файл автоматически удаляется при завершении сессии iclaude.sh)
#
# По умолчанию: info
# ICLAUDE_PII_PROXY_LOG_LEVEL=debug

# Срок хранения лог-файлов PII proxy (в днях).
# Файлы *.log в pii-proxy-logs/ старше этого порога удаляются при запуске iclaude.
# access.log и ccr-daemon.log не затрагиваются (агрегирующие, не сессионные).
# По умолчанию: 7
# ICLAUDE_PII_LOG_RETENTION_DAYS=7

# Срок хранения директорий session-env/ (в днях).
# Claude Code создаёт по одной подпапке на каждую сессию.
# Пустые папки удаляются через SESSION_ENV_RETENTION_DAYS дней.
# Непустые папки удаляются через SESSION_ENV_RETENTION_DAYS × 4 дней.
# По умолчанию: 7 (пустые) / 28 (непустые)
# ICLAUDE_SESSION_ENV_RETENTION_DAYS=7

# Токен замены PII при маскировании (режим standard).
# Подставляется вместо персональных данных, обнаруженных Presidio NLP.
# По умолчанию: REDACTED (без скобок — не конфликтует с Markdown ссылками)
# Пример удаления: PII_PROXY_MASK_TOKEN=""
# ICLAUDE_PII_PROXY_MASK_TOKEN="REDACTED"

# Диапазон портов для автовыбора PII proxy (по умолчанию 20000–40000).
# Порт выбирается случайно из диапазона при каждом запуске сессии.
# Задайте PII_PROXY_PORT=<N> для фиксации конкретного порта (например, для firewall-правил).
# ICLAUDE_PII_PROXY_PORT=0
# ICLAUDE_PII_PROXY_PORT_MIN=20000
# ICLAUDE_PII_PROXY_PORT_MAX=40000

# Таймауты соединения PII proxy с upstream (в секундах).
# Раздельные connect/read: connect — установка TCP-соединения, read — ожидание ответа.
# Read=300 рассчитан на долгие ответы (Opus + extended thinking + большие промпты);
# при слишком низком значении возможны ложные «502 PII proxy upstream unavailable».
# По умолчанию: connect=10, read=300
# ICLAUDE_PII_PROXY_CONNECT_TIMEOUT=10
# ICLAUDE_PII_PROXY_READ_TIMEOUT=300

# Супервизор PII proxy: перезапускает рабочий процесс при его гибели (OOM/краш/kill),
# сохраняя ТОТ ЖЕ порт. Без него зависшая сессия получает «Unable to connect to API
# (ConnectionRefused)», т.к. ANTHROPIC_BASE_URL фиксируется при старте. Рекомендуется true.
# При крэш-цикле (>5 перезапусков за 10с) супервизор завершается с ошибкой в логе.
# По умолчанию: true
# ICLAUDE_PII_PROXY_SUPERVISE=true

# ------------------------------------------------------------
# Переменные окружения, автоматически экспортируемые при старте
# PII proxy (устанавливаются launch.sh — не задавайте вручную):
#
#   ICLAUDE_PII_ACTIVE=1
#     Флаг активности прокси; используется статуслайном для отображения 🛡.
#
#   ICLAUDE_PII_MASKING_LEVEL=<off|secrets|standard>
#     Уровень маскирования текущего сеанса (копия PII_PROXY_MASKING_LEVEL).
#
#   ICLAUDE_PII_ACTIVE_PORT=<port>
#     Порт слушающего прокси; статуслайн использует для GET /api/metrics.
#
#   ICLAUDE_PII_LOG_PATH=<project>/.claude/pii/<YYYY-MM-DD>/<session>.toon
#     Путь к TOON audit-лог файлу текущей сессии.
#     Иконка 🛡 в статуслайне становится кликабельной (OSC 8) когда файл существует.
#     Каталог .claude/pii/ автоматически добавляется в .gitignore проекта.
# ------------------------------------------------------------

# ============================================================================
#  Langfuse-захват вне router-режима (опционально)
# ============================================================================
# Захват полного промпта+ответа каждого LLM-вызова (non-router путь) в self-hosted
# Langfuse с тегом project:<repo>. Использует PII proxy как транспорт: включение
# запускает прокси даже без USE_PII_PROXY (маскирование off, если PII_PROXY_MASKING_LEVEL
# не задан явно). И запрос, и ответ, отправляемые в Langfuse, ВСЕГДА очищаются от
# секретов (regex-скраб), независимо от уровня маскирования.
# Автоматически пропускается в --router режиме (там LiteLLM уже шлёт трейсы в Langfuse).
# ICLAUDE_USE_LANGFUSE_CAPTURE=true
# ICLAUDE_LANGFUSE_HOST="https://langfuse.example"
# ICLAUDE_LANGFUSE_PUBLIC_KEY="pk-lf-..."
# ICLAUDE_LANGFUSE_SECRET_KEY="sk-lf-..."   # секрет — держите .claude_config в chmod 600

# ============================================================
#  MICRO-VM SANDBOX (Firecracker — изоляция на уровне ядра)
# ============================================================
# Запускает Claude Code ВНУТРИ Firecracker guest VM по SSH.
# Guest kernel изолирован от host kernel — максимальная защита от prompt injection
# → kernel exploit цепочки. Workspace синхронизируется через tar-over-SSH.
#
# Архитектура v2: guest PID 1 (iclaude-guest-init) монтирует блочные устройства:
#   /dev/vdb → /mnt/nvm    (NVM snapshot, RO — Node.js + claude binary)
#   /dev/vdc → /workspace  (per-session sparse ext4, RW)
#
# Требования:
#   - KVM поддержка (/dev/kvm): Linux с аппаратной виртуализацией
#   - Однократная установка: ./iclaude.sh --install-microvm
#     (скачивает firecracker ~22MB, vmlinux ~20MB, rootfs.ext4 ~30MB,
#      строит nvm.img ~1GB из .nvm-isolated/ в .nvm-isolated/.claude-isolated/bin/)
#   - TAP networking: ./iclaude.sh --install-microvm настроит автоматически
#     (требует sudo для ip tuntap + iptables)
#
# Режимы запуска:
#   solo:     --sandbox-microvm           → claude внутри VM → Anthropic API
#   combined: --sandbox-microvm --pii-proxy → PII proxy на хосте (TAP IP) → VM → API
#
# Статус: ./iclaude.sh --check-microvm
#
# true  — автозапуск VM при каждом старте claude (если KVM доступен)
# false — отключено (можно включить разово: --sandbox-microvm)
# По умолчанию: false
ICLAUDE_MICRO_VM_ENABLED=false

# Backend виртуализации.
# firecracker — единственный поддерживаемый вариант в текущей версии.
# По умолчанию: firecracker
# ICLAUDE_MICRO_VM_BACKEND=firecracker

# Количество виртуальных CPU для гостя.
# Диапазон: 1–8. По умолчанию: 2
# ICLAUDE_MICRO_VM_VCPU=2

# Объём RAM гостя в MiB.
# Диапазон: 512–8192. По умолчанию: 2048
#
# Claude Code (Node.js) занимает ~600 MB RSS в базовом состоянии;
# с большими проектами и tool calls потребление может достигать 1.5–2 GB.
# При нехватке памяти OOM killer завершает процесс без предупреждения (нет swap).
# Примеры:
#   1024 — минимально для тестирования, риск OOM при больших проектах
#   2048 — дефолт; минимум для стабильной работы
#   4096 — для крупных монорепозиториев и интенсивного использования
# ICLAUDE_MICRO_VM_MEM_MB=2048

# Включить TAP networking (доступ к сети из гостя через NAT).
# Требуется для: Anthropic API, прокси, загрузок внутри VM.
# false — полностью изолированный гость без сети (максимальная безопасность).
# По умолчанию: true
# ICLAUDE_MICRO_VM_NET_ENABLED=true

# Имя TAP-интерфейса для слота 0 на хосте.
# При запуске нескольких concurrent сессий: слот 1 → tap-iclaude-1, слот 2 → tap-iclaude-2 и т.д.
# Изменяйте только при конфликте с существующими интерфейсами.
# По умолчанию: tap-iclaude
# ICLAUDE_MICRO_VM_NET_TAP_IFACE=tap-iclaude

# Пул адресов для гостевых VM в CIDR-нотации.
# Каждая сессия автоматически получает уникальную пару адресов из этого пула:
#   Слот 0: хост=base+1 (172.16.0.1), гость=base+2 (172.16.0.2), TAP=tap-iclaude
#   Слот 1: хост=base+3 (172.16.0.3), гость=base+4 (172.16.0.4), TAP=tap-iclaude-1
#   ...
# /26 → 31 concurrent сессии; /28 → 7; /30 → 1.
# По умолчанию: 172.16.0.0/26
# ICLAUDE_MICRO_VM_NET_SUBNET=172.16.0.0/26

# Использовать снэпшоты для быстрого старта VM.
# true  — повторный запуск ~125ms (снэпшот восстанавливается)
# false — каждый запуск холодный ~1-2s (без снэпшота)
# По умолчанию: false
# ICLAUDE_MICRO_VM_SNAPSHOT_ENABLED=false

# Директория для хранения снэпшотов VM.
# По умолчанию: .nvm-isolated/.claude-isolated/microvm-snapshots/
# ICLAUDE_MICRO_VM_SNAPSHOT_DIR=

# Путь к rootfs образу (ext4, Alpine Linux ~30MB).
# По умолчанию: .nvm-isolated/.claude-isolated/bin/rootfs.ext4
# Устанавливается автоматически через --install-microvm.
# ICLAUDE_MICRO_VM_ROOTFS_PATH=

# Размер rootfs образа в МБ (vda — системный диск гостя: OS, /home, /etc, логи).
# При запуске --install-microvm rootfs автоматически расширяется до этого значения.
# При повторном --install-microvm предлагается resize если текущий размер меньше.
# При старте VM: авто-рост если свободно < 30% (независимо от этой переменной).
#
# Скачанный rootfs: ~265MB. Claude Code + OS в использовании: ~350-400MB.
# Рекомендуемые значения:
#   500  — минимум для базовой работы (исторический дефолт до v8)
#   2048 — дефолт; достаточно для крупных проектов и npm-операций
#   4096 — для интенсивных операций с большими бинарями в rootfs
#
# ВАЖНО: workspace файлы (проект) хранятся в /workspace (vdc = workspace.img),
#        не в rootfs. Для размера workspace используйте MICRO_VM_WORKSPACE_SIZE_MB.
# По умолчанию: 2048
# ICLAUDE_MICRO_VM_ROOTFS_SIZE_MB=2048

# Размер workspace образа в МБ (vdc — диск для /workspace: файлы проекта).
# Sparse-файл на хосте: реально занимает только фактически использованное место.
# При каждом запуске создаётся новый per-session образ указанного размера.
# Рекомендуемые значения:
#   2048 — дефолт; достаточно для большинства проектов
#   8192 — для монорепозиториев и проектов с большими артефактами (node_modules, dist)
#  20480 — для проектов с моделями ML или большими бинарными данными
# По умолчанию: 2048
# ICLAUDE_MICRO_VM_WORKSPACE_SIZE_MB=2048

# Путь к ядру Linux для гостя (vmlinux, ~20MB).
# По умолчанию: .nvm-isolated/.claude-isolated/bin/vmlinux
# Устанавливается автоматически через --install-microvm.
# ICLAUDE_MICRO_VM_KERNEL_PATH=

# Уровень логирования Firecracker VMM.
# debug | info | warn | error
# По умолчанию: warn
# ICLAUDE_MICRO_VM_LOG_LEVEL=warn

# Отключить проверку TLS-сертификата при загрузке компонентов microVM.
# Используется как временное решение при ошибке TLS на системах со старым OpenSSL
# (например, ALT Linux 10 с OpenSSL < 3.x): error:0B09406F:x509 certificate routines:...
# true  — добавляет -k (--insecure) к curl; SHA-256 верификация через versions.json сохраняется
# false — стандартная загрузка с проверкой TLS-сертификата (по умолчанию)
# ВАЖНО: используйте только в доверенной сети. Сразу после установки проверьте versions.json.
# По умолчанию: false
# ICLAUDE_MICRO_VM_INSECURE_DOWNLOAD=false

# Передавать настройки прокси в гостевую VM.
# true  — PROXY_URL, PROXY_CA пробрасываются в гостя через TAP (host IP в качестве шлюза)
# false — гость использует прямое соединение
# По умолчанию: true
# ICLAUDE_MICRO_VM_PROXY_PASS=true

# Режим синхронизации рабочего каталога с гостевой VM.
# Синхронизация выполняется через tar-over-SSH. Секретные файлы всегда исключены из sync:
# .claude_config, .iclaude-guest-env.sh, .iclaude-ssh/, .nvm-isolated/, .git/
#
# full     — двунаправленная синхронизация:
#            host→guest при запуске, guest→host после завершения.
#            MICRO_VM_WORKSPACE_PATH (или $PWD) — источник workspace.
#            Режим по умолчанию.
#
# isolated — одностороннее копирование:
#            host→guest при запуске (как full), но без sync-back.
#            Файлы на хосте остаются неизменными после работы claude.
#            MICRO_VM_WORKSPACE_PATH (или $PWD) — источник для копирования.
#
# По умолчанию: full
# ICLAUDE_MICRO_VM_WORKSPACE_MODE=full

# Источник workspace для режима full.
# Задаёт директорию, которая синхронизируется в /workspace гостевой VM.
# Если не задан — используется $PWD (текущий каталог при запуске iclaude.sh).
# Позволяет работать с конкретным проектом независимо от cwd.
# Пример: /home/user/projects/my-project
# ICLAUDE_MICRO_VM_WORKSPACE_PATH=

# Интервал периодической синхронизации workspace (guest→host) в секундах.
# Применяется только в режиме full. При значении 0 (по умолчанию) периодическая
# синхронизация отключена — изменения синхронизируются только после завершения сессии.
#
# При ненулевом значении: фоновый процесс каждые N секунд копирует /workspace
# из guest на хост, делая изменения видимыми на хосте без ожидания выхода из claude.
#
# С SSH ControlMaster + rsync (rootfs v7): минимум 2s безопасен (delta sync, overhead ~5ms).
# Без rsync (rootfs v6, tar-over-SSH): минимум 20-30s (SSH handshake 150-320ms per sync).
# Рекомендуемые значения:
#   0  — только при выходе (по умолчанию, без накладных расходов)
#   5  — каждые 5 секунд (с rsync+ControlMaster, near-realtime sync)
#   30 — каждые 30 секунд (tar fallback или баланс нагрузки)
# ICLAUDE_MICRO_VM_SYNC_INTERVAL=0

# ============================================================
#  ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ CLAUDE CODE
# ============================================================
# Переменные Claude Code, используемые при запуске процесса.
# Все переменные передаются в окружение Claude Code автоматически
# при старте через iclaude.sh.

# --- API / Сеть ---

# Переопределить endpoint API Anthropic (кастомный gateway, локальный прокси).
# По умолчанию: https://api.anthropic.com
# Пример: ANTHROPIC_BASE_URL=http://localhost:8080/proxy/anthropic
# ICLAUDE_ANTHROPIC_BASE_URL=

# Альтернативный токен аутентификации для корпоративных AI-gateway.
# Используется когда gateway не принимает стандартный ANTHROPIC_API_KEY.
# ICLAUDE_ANTHROPIC_AUTH_TOKEN=

# Дополнительные CA-сертификаты для Node.js (корпоративные PKI).
# Если используется PROXY_CA — устанавливается автоматически, задавать вручную не нужно.
# Задайте вручную только если CA нужен без прокси (независимый от PROXY_CA сценарий).
# Пример: NODE_EXTRA_CA_CERTS=/etc/ssl/certs/corporate-ca.crt
# ICLAUDE_NODE_EXTRA_CA_CERTS=

# --- Контекст / Память ---

# Лимит контекстного окна в токенах.
# По умолчанию: максимум модели (200K для claude-sonnet-4-6).
# Уменьшите для экономии или при работе с ограниченными провайдерами.
# ICLAUDE_CLAUDE_CODE_MAX_CONTEXT_TOKENS=

# Отключить автоматическую память (сохранение контекста между сессиями).
# 1 — отключить (каждая сессия начинается с чистого листа)
# ICLAUDE_CLAUDE_CODE_DISABLE_AUTO_MEMORY=

# Переопределить размер окна для авто-компакции контекста.
# По умолчанию: зависит от модели (обычно 80% от MAX_CONTEXT_TOKENS).
# ICLAUDE_CLAUDE_CODE_AUTO_COMPACT_WINDOW=

# Порог авто-компакции в % заполнения контекста (0–100).
# По умолчанию: ~95. Уменьшите если компакция происходит слишком поздно.
# ICLAUDE_CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=

# --- Производительность ---

# Максимальное число параллельных вызовов инструментов.
# По умолчанию: 10. Уменьшите при проблемах с rate-limit провайдера.
# ICLAUDE_CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY=

# Лимит вывода Bash-инструмента в символах.
# По умолчанию: 30000. Увеличьте для длинных логов.
# ICLAUDE_BASH_MAX_OUTPUT_LENGTH=

# Лимит токенов при чтении файлов (Read tool).
# По умолчанию: зависит от модели. Уменьшите для сокращения расхода токенов.
# ICLAUDE_CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS=

# Бюджет токенов при extended thinking (работает только с DISABLE_ADAPTIVE_THINKING=1).
# По умолчанию: 10000. Используйте с Opus/Sonnet 4.6 в режиме фиксированного бюджета.
# ICLAUDE_MAX_THINKING_TOKENS=

# --- Дисплей / UI ---

# Скрыть рабочую директорию в логотипе при запуске.
# 1 — скрыть (полезно в shared/demo окружениях)
# ICLAUDE_CLAUDE_CODE_HIDE_CWD=

# Компактный режим вывода (сокращённые сообщения).
# 1 — включить
# ICLAUDE_CLAUDE_CODE_BRIEF=

# Множитель скорости прокрутки терминала (float, 0.1–20).
# По умолчанию: 3 в Windows Terminal, 1 иначе.
# ICLAUDE_CLAUDE_CODE_SCROLL_SPEED=

# Сохранять truecolor под tmux (предотвращает деградацию до 256 цветов).
# 1 — включить
# ICLAUDE_CLAUDE_CODE_TMUX_TRUECOLOR=

# Уменьшить мерцание при перерисовке терминала.
# 1 — включить (рекомендуется при мерцании в slow terminal)
# ICLAUDE_CLAUDE_CODE_NO_FLICKER=

# Отключить захват мыши в терминале.
# 1 — отключить (если мышь мешает выделению текста в терминале)
# ICLAUDE_CLAUDE_CODE_DISABLE_MOUSE=

# --- Сессия ---

# Порог (в минутах) для предложения возобновить предыдущую сессию при запуске.
# По умолчанию: 5. 0 — никогда не предлагать.
# ICLAUDE_CLAUDE_CODE_RESUME_THRESHOLD_MINUTES=

# Автоматически возобновлять прерванный ход без запроса подтверждения.
# 1 — включить (удобно в автоматизированных сценариях)
# ICLAUDE_CLAUDE_CODE_RESUME_INTERRUPTED_TURN=

# --- Провайдеры (Bedrock / Vertex) ---

# Использовать AWS Bedrock вместо Anthropic API.
# 1 — включить (требует настройки AWS credentials)
# ICLAUDE_CLAUDE_CODE_USE_BEDROCK=

# Использовать Google Vertex AI вместо Anthropic API.
# 1 — включить (требует настройки GCP credentials)
# ICLAUDE_CLAUDE_CODE_USE_VERTEX=

# Tier сервиса AWS Bedrock.
# default  — стандартный tier
# flex     — гибкий tier (pay-per-token, без резервирования)
# priority — приоритетный tier (зарезервированные ресурсы)
# ICLAUDE_ANTHROPIC_BEDROCK_SERVICE_TIER=default

# --- Прочее ---

# Отключить весь нецелевой трафик (телеметрия, аналитика, ping).
# 1 — отключить (рекомендуется в air-gapped средах)
# ICLAUDE_CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=

# Управление заголовком атрибуции (x-anthropic-attribution).
# 0 — отключить заголовок (ускоряет локальные/прокси модели, сохраняет KV-кэш)
# По умолчанию: 1 (заголовок отправляется)
# ICLAUDE_CLAUDE_CODE_ATTRIBUTION_HEADER=

# ============================================================
#  ОТЛАДКА
# ============================================================
# Включить подробный вывод при запуске claude в launch.sh.
# 1 — показывать: путь к бинарю, аргументы, переменные окружения
# (оставить пустым для отключения)
ICLAUDE_DEBUG_LAUNCH=

# ============================================================
#  ПРИМЕР МИНИМАЛЬНОЙ КОНФИГУРАЦИИ (только прокси)
# ============================================================
# ICLAUDE_PROXY_URL=https://[CREDENTIALS]@proxy.company.com:8118
# ICLAUDE_PROXY_CA=/etc/ssl/company/corporate-ca.crt

# ============================================================
#  ПРИМЕР КОНФИГУРАЦИИ С РОУТЕРОМ (DeepSeek + Ollama)
# ============================================================
# ICLAUDE_PROXY_URL=https://[CREDENTIALS]@proxy.company.com:8118
# ICLAUDE_PROXY_CA=/etc/ssl/company/corporate-ca.crt
#
# ICLAUDE_DEEPSEEK_API_KEY=[API_KEY_REDACTED]
# ICLAUDE_OPENROUTER_API_KEY=[API_KEY_REDACTED]
# ICLAUDE_GOOGLE_API_KEY=[GOOGLE_API_KEY]
#
# ICLAUDE_CLAUDE_CODE_ENABLE_TASKS=true

# ============================================================
#  ПРИМЕР КОНФИГУРАЦИИ С РОУТЕРОМ (Anthropic + Ollama)
# ============================================================
# Роутинг: main/think/longContext → Anthropic, background → Ollama
# router.json: {"Router": {"default": "anthropic,claude-sonnet-4-6",
#                           "background": "ollama,qwen2.5:7b", ...}}
# Провайдер Anthropic в router.json: "api_key": "${ANTHROPIC_API_KEY}" (без UseBearer)
#
# ICLAUDE_ANTHROPIC_API_KEY=[API_KEY_REDACTED]

# ============================================================
#  ПРИМЕР КОНФИГУРАЦИИ С PII PROXY
# ============================================================
# ICLAUDE_USE_PII_PROXY=true
# # При первом использовании установить: ./iclaude.sh --install-pii-proxy
# #
# # Уровень маскирования (по умолчанию: standard — Presidio NLP + regex):
# # ICLAUDE_PII_PROXY_MASKING_LEVEL=standard   # полное (NLP + regex) — максимальная защита
# # ICLAUDE_PII_PROXY_MASKING_LEVEL=secrets    # только regex — быстро, без NLP
# # ICLAUDE_PII_PROXY_MASKING_LEVEL=off        # без маскирования (только для отладки)
# #
# # Уровень логирования (по умолчанию: info — только счётчик):
# # ICLAUDE_PII_PROXY_LOG_LEVEL=debug          # debug: типы найденных сущностей (авто-удаление лога)
# #
# # Опционально: ограничить диапазон портов (по умолчанию 20000-40000):
# # ICLAUDE_PII_PROXY_PORT_MIN=30000
# # ICLAUDE_PII_PROXY_PORT_MAX=35000

# ============================================================
#  ПРИМЕР КОНФИГУРАЦИИ С MICRO-VM
# ============================================================
# # Базовый microVM — монтировать текущий проект (по умолчанию):
# ICLAUDE_MICRO_VM_ENABLED=true
# ICLAUDE_MICRO_VM_VCPU=2
# ICLAUDE_MICRO_VM_MEM_MB=2048        # рекомендуемый минимум
# ICLAUDE_MICRO_VM_SYNC_INTERVAL=5    # near-realtime sync (rsync+ControlMaster, v7 rootfs)
#
# # Конкретный путь как источник workspace (независимо от cwd):
# ICLAUDE_MICRO_VM_ENABLED=true
# ICLAUDE_MICRO_VM_WORKSPACE_PATH=/home/user/projects/my-project
#
# # Изоляция: файлы копируются в VM, но изменения не возвращаются на хост:
# ICLAUDE_MICRO_VM_ENABLED=true
# ICLAUDE_MICRO_VM_WORKSPACE_MODE=isolated
# ICLAUDE_MICRO_VM_NET_ENABLED=false   # опционально: отключить и сеть
#
# # С быстрым стартом через снэпшоты:
# ICLAUDE_MICRO_VM_ENABLED=true
# ICLAUDE_MICRO_VM_SNAPSHOT_ENABLED=true

# ============================================================
#  CAVEMAN: TOKEN COMPRESSION (~65-75% output token savings)
# ============================================================
# Install first: ./iclaude.sh --caveman-install
# Remove:        ./iclaude.sh --caveman-remove
# Status:        ./iclaude.sh --check-caveman
#
# # Mode (default: full). Reads from process.env.CAVEMAN_DEFAULT_MODE in hook.
# # off | lite | full | ultra | wenyan-lite | wenyan-full | wenyan-ultra
# ICLAUDE_CAVEMAN_DEFAULT_MODE=full
#
# # Show token savings badge in status line (default: false):
# ICLAUDE_CAVEMAN_STATUSLINE=true

# ============================================================================
# Telemetry (Claude Code → Grafana)
# ============================================================================
# Telemetry is OPT-IN (default OFF). Enable explicitly (symmetric with ICLAUDE_USE_LANGFUSE_CAPTURE):
# ICLAUDE_USE_OTEL=true
# Kill-switch / explicit opt-out (overrides USE_OTEL): 1=disable.
# ICLAUDE_NO_TELEMETRY=1

# --- Вариант A: Локально (та же машина, трафик не выходит наружу) -----------
# По умолчанию. Collector доступен напрямую на 127.0.0.1:4318, без TLS и auth.
# ICLAUDE_OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"

# --- Вариант B: Внешний (iclaude на другой машине → otel.ikeniborn.ru) ------
# Указать endpoint и credentials (user:password) — lib автоматически сформирует Authorization заголовок.
# ICLAUDE_OTEL_EXPORTER_OTLP_ENDPOINT="https://otel.ikeniborn.ru"
# ICLAUDE_OTEL_EXPORTER_OTLP_CREDENTIALS="user:[PASSWORD_REDACTED]"
# Хост endpoint автоматически добавляется в NO_PROXY (otel.sh:patch_no_proxy_for_telemetry).

# Логирование тела user prompt в Loki (1=on, 0=off).
# Default 0 (приватность — OTEL-канал без scrubbing; контент промптов уже в Langfuse).
# Установить 1 осознанно, для forensic-аудита.
# ICLAUDE_OTEL_LOG_USER_PROMPTS=1

# Метка proxy.profile в resource attrs (default: $PROXY_PROFILE из profile loader).
# ICLAUDE_PROXY_PROFILE=default

# ============================================================
#  IWIKI MCP SERVER (semantic docs wiki over MCP)
# ============================================================
# The iwiki MCP server (`iwiki-mcp`, installed as a uv/pipx tool on PATH) is
# registered at launch from the tracked, secret-free
# .nvm-isolated/.claude-isolated/mcp/iwiki.json via --mcp-config. That file uses
# ${IWIKI_*} placeholders; the values below are de-prefixed by env-map
# (ICLAUDE_IWIKI_X -> IWIKI_X) and expanded into the server's env at spawn time.
# The server is only registered when IWIKI_LLM_KEY is set and `iwiki-mcp`
# resolves on PATH.
#
# Two modes. REMOTE talks to a hosted `iwiki-mcp serve --transport
# streamable-http` over HTTP and needs no local binary, no wiki base, and no
# embeddings key — the server owns storage and credentials, and the bearer token
# selects the wiki plus its read/write grants. Setting the URL is the opt-in, so
# remote wins over a local install when both are configured:
# ICLAUDE_IWIKI_REMOTE_URL="https://iwiki.example/mcp"   # must end at the /mcp endpoint
# ICLAUDE_IWIKI_REMOTE_TOKEN="..."                       # bearer token (secret — keep here, not in git)
#
# Everything below configures the LOCAL (stdio) mode instead.
#
# Required (server halts without these):
# ICLAUDE_IWIKI_BASE_DIR="/home/user/wiki"          # shared wiki base dir
# ICLAUDE_IWIKI_LLM_BASE_URL="https://.../v1"        # OpenAI-compatible embeddings endpoint
# ICLAUDE_IWIKI_LLM_KEY="..."                        # embeddings API key (secret — keep here, not in git)
#
# PostgreSQL storage (only when the project's .iwiki.toml declares
# [storage] type = "postgres"; every other field lives in that TOML file):
# ICLAUDE_IWIKI_DB_PASSWORD="..."                    # database password (secret — keep here, not in git)
#
# Embedding model (defaults shown; EMBED_DIMENSIONS must match the model):
# ICLAUDE_IWIKI_EMBED_MODEL="text-embedding-3-small"
# ICLAUDE_IWIKI_EMBED_DIMENSIONS="1536"
#
# Chat model (optional; empty disables it). When set, the server classifies
# `type`/`tags` frontmatter itself, reusing LLM_BASE_URL / LLM_KEY:
# ICLAUDE_IWIKI_CHAT_MODEL="..."
#
# Reranker (optional; empty disables it). Reuses LLM_BASE_URL / LLM_KEY and
# fails soft, so a missing model degrades to the unreranked result order:
# ICLAUDE_IWIKI_RERANK_MODEL="..."
#
# Server lifecycle: seconds of MCP inactivity after which the stdio server
# exits; 0 disables the limit. A later call reconnects and respawns it:
# ICLAUDE_IWIKI_IDLE_TIMEOUT_SECONDS="86400"
#
# Indexing tuning (optional; server defaults apply when unset):
# ICLAUDE_IWIKI_CHUNK_SIZE="512"
# ICLAUDE_IWIKI_CHUNK_OVERLAP="64"
# ICLAUDE_IWIKI_SUMMARY_MAX_CHARS="400"
#
# Search tuning (optional; server defaults apply when unset). SEARCH_MODE is
# only the default for an omitted wiki_search(mode=...); an explicit mode wins:
# ICLAUDE_IWIKI_SEARCH_MODE="hybrid"                 # hybrid | lexical | semantic
# ICLAUDE_IWIKI_TOP_K="8"
# ICLAUDE_IWIKI_SCORE_THRESHOLD="0.2"
# ICLAUDE_IWIKI_GRAPH_DEPTH="2"
# ICLAUDE_IWIKI_SEED_TOP_K="5"                       # articles seeded before graph expansion
# ICLAUDE_IWIKI_BFS_TOP_K="10"                       # cap on graph-expanded articles
# ICLAUDE_IWIKI_SEED_THRESHOLD="0.15"                # minimum seed similarity for a read
# ICLAUDE_IWIKI_WRITE_SEED_THRESHOLD="0.35"          # stricter seed similarity for intent="write"
#
# Python code graph (optional; wiki_code_index / wiki_code_search / wiki_code_context).
# Its home is the project's .iwiki.toml [code_graph] table — the server applies
# these variables AFTER that table, so anything set here overrides EVERY project
# you open with iclaude. Leave them unset unless you want exactly that; when
# unset, iclaude forwards nothing and .iwiki.toml stays authoritative.
# ICLAUDE_IWIKI_CODE_GRAPH_ENABLED="true"            # true | false (exact strings)
# ICLAUDE_IWIKI_CODE_GRAPH_AUTO_REBUILD="bounded"    # bounded | off
# ICLAUDE_IWIKI_CODE_GRAPH_MAX_FILE_BYTES="1000000"
# ICLAUDE_IWIKI_CODE_GRAPH_MAX_FILES="20000"
#
# Optional: publish this machine's local code-graph snapshot to a hosted iwiki
# MCP endpoint (local stdio server only; a remote/hosted server ignores these).
# ICLAUDE_IWIKI_CODE_GRAPH_MCP_URL="https://iwiki.example.com/mcp"
# ICLAUDE_IWIKI_CODE_GRAPH_MCP_TOKEN="..."           # secret — keep here, not in git
#
# Optional: override the binary path (default: resolved via `command -v iwiki-mcp`):
# ICLAUDE_IWIKI_COMMAND=/path/to/iwiki-mcp
