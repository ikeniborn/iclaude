#!/bin/bash
# .claude_config.example — шаблон конфигурации iclaude
#
# Использование:
#   cp .claude_config.example .claude_config
#   # Отредактировать .claude_config, заполнить нужные значения
#
# ВАЖНО: .claude_config добавлен в .gitignore — не коммитить!
# Файл содержит секреты: пароли прокси, API ключи.
#
# Файл автоматически загружается при запуске ./iclaude.sh
# Все переменные становятся доступны в окружении Claude Code.
#
# Формат: bash-переменные (KEY=value или export KEY=value)
# Пустые значения (KEY=) — переменная игнорируется.

# ============================================================
#  ПРОКСИ-СЕРВЕР
# ============================================================
# Адрес прокси-сервера.
# Форматы:
#   https://host:port                    — без аутентификации
#   https://user:password@host:port      — с логином/паролем
#   http://user:password@host:port       — HTTP прокси (хуже для OAuth)
#
# HTTPS прокси рекомендуется: сохраняет доменные имена для OAuth/TLS.
# HTTP прокси не рекомендуется: проблемы с TLS-сертификатами Anthropic.
# SOCKS5 не поддерживается: вызывает сбой в undici (Node.js HTTP-клиент).
#
# По умолчанию: не задан (прокси не используется).
# Устанавливается через: ./iclaude.sh --proxy https://user:pass@proxy:8118
PROXY_URL=

# Отключить проверку TLS-сертификата прокси-сервера.
# true  — отключить (небезопасно, используйте только в крайнем случае)
# false — включить (по умолчанию)
#
# Альтернатива: PROXY_CA (безопасный способ)
PROXY_INSECURE=false

# Путь к CA-сертификату прокси-сервера (PEM-формат).
# Используется, когда прокси перехватывает HTTPS (corporate MITM proxy).
# Пример: /etc/ssl/certs/my-corp-ca.pem
#
# По умолчанию: не задан (дополнительный CA-сертификат не устанавливается).
# Если задан, устанавливает NODE_EXTRA_CA_CERTS автоматически.
# Предпочтительнее PROXY_INSECURE=true.
PROXY_CA=

# Список хостов, которые должны обходить прокси (через запятую).
# Значение по умолчанию (если не задано):
#   localhost,127.0.0.1,::1,github.com,githubusercontent.com,
#   gitlab.com,bitbucket.org,registry.npmjs.org,nodejs.org
#
# Добавьте внутренние хосты, которые не должны идти через прокси.
NO_PROXY=

# ============================================================
#  МОДЕЛЬ CLAUDE CODE
# ============================================================
# Принудительно задать модель Claude Code (переопределяет настройки по умолчанию).
#
# Используется при запуске без роутера (нативный Claude API).
# При запуске с роутером (--router) модель задаётся в router.json.
# По умолчанию (если не задан): claude-sonnet-4-6
#
# Устанавливается через: ./iclaude.sh --model claude-sonnet-4-6
CLAUDE_CODE_MODEL=

# Нативная переменная Claude Code для выбора модели по умолчанию.
# Альтернатива CLAUDE_CODE_MODEL: читается напрямую Claude Code (без флага --model).
# Если задан и CLAUDE_CODE_MODEL — флаг --model имеет приоритет.
# По умолчанию (если не задан): claude-sonnet-4-6
# Пример: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5-20251001
ANTHROPIC_MODEL=

# Переопределить alias-маппинг семейств моделей (opus/sonnet/haiku → конкретная версия).
# Полезно для закрепления точной версии модели без изменения конфигов роутера.
# По умолчанию: последняя версия соответствующего семейства.
ANTHROPIC_DEFAULT_OPUS_MODEL=   # По умолчанию: claude-opus-4-6
ANTHROPIC_DEFAULT_SONNET_MODEL= # По умолчанию: claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL=  # По умолчанию: claude-haiku-4-5-20251001

# ============================================================
#  НАСТРОЙКИ CLAUDE CODE
# ============================================================
# Максимальное количество токенов в ответе.
# По умолчанию: зависит от модели (обычно 8192 или 32768).
# Увеличьте для длинных генераций кода.
CLAUDE_CODE_MAX_OUTPUT_TOKENS=

# Включить систему задач (Tasks).
# true  — включить (по умолчанию в iclaude)
# false — отключить (использовать только если Tasks вызывают проблемы)
#
# Tasks позволяют создавать списки задач (TaskCreate/TaskUpdate/TaskList)
# и отслеживать прогресс в интерактивном режиме.
CLAUDE_CODE_ENABLE_TASKS=true

# Отключить интеграцию с Chrome.
# true  — отключить Chrome-инструменты (mcp__claude-in-chrome__*)
# false — включить (по умолчанию)
#
# Отключается через: ./iclaude.sh --no-chrome
CLAUDE_CODE_NO_CHROME=

# Таймаут сессии в секундах.
# По умолчанию: не задан (используется таймаут Claude Code по умолчанию).
CLAUDE_CODE_SESSION_TIMEOUT=

# Экспериментальная поддержка команд агентов (Agent Teams).
# true  — включить (нестабильно, экспериментально)
# false — отключить (по умолчанию)
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=

# Отдельная модель для субагентов (Task tool, параллельные агенты).
# По умолчанию: Haiku (быстрый и дешёвый для фоновых подзадач).
# Пример: claude-sonnet-4-6 — если субагентам нужно более высокое качество.
CLAUDE_CODE_SUBAGENT_MODEL=

# Уровень усилий Claude Code (влияет на extended thinking и глубину анализа).
# low    — быстро, меньше thinking
# medium — баланс скорости и качества (по умолчанию)
# high   — максимальное качество, больше thinking (дороже)
CLAUDE_CODE_EFFORT_LEVEL=

# Отключить extended thinking (adaptive thinking) у Opus/Sonnet 4.6.
# 1 — отключить (ускоряет ответы, снижает стоимость, отключает глубокий анализ)
# (оставить пустым — adaptive thinking включён по умолчанию)
CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING=

# Отключить расширенный контекст (200K context window).
# 1 — использовать стандартный контекст модели
# По умолчанию: не задан (расширенный контекст активен)
CLAUDE_CODE_DISABLE_1M_CONTEXT=

# Отключить экспериментальные API-фичи (beta endpoints).
# 1 — только стабильные API (рекомендуется для production-сред)
# По умолчанию: не задан (experimental betas включены)
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=

# ============================================================
#  ROUTER: API-КЛЮЧИ LLM-ПРОВАЙДЕРОВ
# ============================================================
# Используются в router.json через плейсхолдеры ${VAR_NAME}.
# Пример в router.json: "api_key": "${DEEPSEEK_API_KEY}"
#
# Для активации роутера: ./iclaude.sh --router
# Конфиг роутера: .nvm-isolated/.claude-isolated/router.json
# Шаблон конфига: .nvm-isolated/.claude-isolated/router.json.example
#
# В дефолтном router.json.example используются: DeepSeek, OpenRouter, Google.
# Groq, Volcengine, SiliconFlow — для кастомных конфигураций роутера.

# --- Anthropic API key (для роутинга через CCR) ---
# Нужен при роутинге через CCR к Anthropic (--router + Anthropic в router.json).
# В нативном режиме (без --router) Claude Code использует OAuth из .credentials.json — API ключ не нужен.
# ВАЖНО: OAuth токен подписки (sk-ant-oat01-...) НЕ принимается api.anthropic.com.
#   CCR требует обычный API ключ. Без него используйте Ollama/DeepSeek/OpenRouter.
# Получить ключ: https://console.anthropic.com/settings/keys
# Формат: sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export ANTHROPIC_API_KEY=

# --- DeepSeek ---
# Используется в router.json.example (провайдер по умолчанию)
# Получить ключ: https://platform.deepseek.com/api_keys
# Формат: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export DEEPSEEK_API_KEY=

# --- OpenRouter ---
# Агрегатор: 300+ моделей через единый API (GPT, Gemini, Llama, Mistral и др.)
# Используется в router.json.example
# По умолчанию: не задан (провайдер не используется без ключа)
# Получить ключ: https://openrouter.ai/keys
# Формат: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export OPENROUTER_API_KEY=

# --- Google Gemini ---
# Используется в router.json.example (gemini-2.5-pro для длинного контекста)
# По умолчанию: не задан (провайдер не используется без ключа)
# Получить ключ: https://aistudio.google.com/app/apikey
# Формат: AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export GOOGLE_API_KEY=

# --- Groq (опционально) ---
# Сверхбыстрый inference на специализированном железе (LPU).
# Не включён в дефолтный router.json.example — добавьте вручную при необходимости.
# Получить ключ: https://console.groq.com/keys
# Формат: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export GROQ_API_KEY=

# --- Volcengine (ByteDance, опционально) ---
# Облако ByteDance: модели Doubao-pro, Doubao-lite.
# Не включён в дефолтный router.json.example — добавьте вручную при необходимости.
# Получить ключ: https://console.volcengine.com/ark
export VOLCENGINE_API_KEY=

# --- SiliconFlow (опционально) ---
# Китайская платформа: Qwen, DeepSeek, GLM через OpenAI-совместимый API.
# Не включён в дефолтный router.json.example — добавьте вручную при необходимости.
# Получить ключ: https://cloud.siliconflow.cn/account/ak
# Формат: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export SILICONFLOW_API_KEY=

# ============================================================
#  PII PROXY (маскирование PII/секретов в API-трафике)
# ============================================================
# Включить HTTP-прокси с Presidio NLP для перехвата /v1/messages.
# Маскирует PII и секреты в системном промпте, сообщениях и tool_results
# перед отправкой в Anthropic API.
#
# Требуется однократная установка: ./iclaude.sh --install-pii-proxy
# Статус: ./iclaude.sh --check-pii-proxy
#
# Режимы запуска (каждая сессия запускает собственный прокси-процесс):
#   solo:     --pii-proxy           → claude → PII proxy (авто-порт) → Anthropic API
#   combined: --pii-proxy --router  → claude → PII proxy (авто-порт) → CCR (:3456) → провайдеры
#
# Параллельные сессии iclaude не конфликтуют: каждая получает изолированный
# прокси-процесс на своём порту из диапазона PII_PROXY_PORT_MIN..PII_PROXY_PORT_MAX.
#
# true  — автозапуск прокси при каждом старте claude
# false — прокси не стартует (можно включить разово: --pii-proxy)
# По умолчанию: false
USE_PII_PROXY=false

# Уровень маскирования PII proxy.
# Управляет агрессивностью маскирования содержимого API-запросов:
#
#   off      — маскирование отключено; прокси работает, содержимое передаётся без изменений.
#              Используйте для отладки или если маскирование мешает работе.
#
#   secrets  — только регулярные выражения (API ключи, токены, пароли, URL с учётными данными).
#              Быстро, без NLP. Не обнаруживает имена, email, телефоны, адреса.
#              Рекомендуется для минимального overhead без потери защиты секретов.
#
#   standard — полное маскирование: Presidio NLP + регулярные выражения (по умолчанию).
#              Маскирует имена, email, телефоны, адреса, номера карт + все типы секретов.
#              Требует установленного Presidio; при отсутствии — fallback на режим secrets.
#
# По умолчанию: standard
# PII_PROXY_MASKING_LEVEL=standard

# Диапазон портов для автовыбора PII proxy (по умолчанию 20000–40000).
# Порт выбирается случайно из диапазона при каждом запуске сессии.
# Задайте PII_PROXY_PORT=<N> для фиксации конкретного порта (например, для firewall-правил).
# PII_PROXY_PORT=0
# PII_PROXY_PORT_MIN=20000
# PII_PROXY_PORT_MAX=40000

# ------------------------------------------------------------
# Переменные окружения, автоматически экспортируемые при старте
# PII proxy (устанавливаются launch.sh — не задавайте вручную):
#
#   ICLAUDE_PII_ACTIVE=1
#     Флаг активности прокси; используется статуслайном для отображения 🛡.
#
#   ICLAUDE_PII_MASKING_LEVEL=<off|secrets|standard>
#     Уровень маскирования текущего сеанса (копия PII_PROXY_MASKING_LEVEL).
#
#   ICLAUDE_PII_ACTIVE_PORT=<port>
#     Порт слушающего прокси; статуслайн использует для GET /api/metrics.
#
#   ICLAUDE_PII_LOG_PATH=<project>/.claude/pii/<YYYY-MM-DD>/<session>.toon
#     Путь к TOON audit-лог файлу текущей сессии.
#     Иконка 🛡 в статуслайне становится кликабельной (OSC 8) когда файл существует.
#     Каталог .claude/pii/ автоматически добавляется в .gitignore проекта.
# ------------------------------------------------------------

# ============================================================
#  MICRO-VM SANDBOX (Firecracker — изоляция на уровне ядра)
# ============================================================
# Запускает Claude Code внутри лёгкой виртуальной машины (Firecracker + KVM).
# Guest kernel изолирован от host kernel — максимальная защита от prompt injection
# → kernel exploit цепочки. Рабочий проект монтируется в VM через virtiofs.
#
# Требования:
#   - KVM поддержка (/dev/kvm): Linux с аппаратной виртуализацией
#   - virtiofsd: sudo apt-get install virtiofsd
#   - Однократная установка: ./iclaude.sh --install-microvm
#     (скачивает firecracker ~22MB, vmlinux ~20MB, rootfs.ext4 ~30MB
#      в .nvm-isolated/.claude-isolated/bin/ — не попадают в git)
#   - TAP networking: ./iclaude.sh --install-microvm настроит автоматически
#     (требует sudo для ip tuntap + iptables)
#
# Режимы запуска:
#   solo:     --sandbox-microvm           → claude внутри VM → Anthropic API
#   combined: --sandbox-microvm --pii-proxy → PII proxy на хосте (TAP IP) → VM → API
#
# Статус: ./iclaude.sh --check-microvm
#
# true  — автозапуск VM при каждом старте claude (если KVM доступен)
# false — отключено (можно включить разово: --sandbox-microvm)
# По умолчанию: false
MICRO_VM_ENABLED=false

# Backend виртуализации.
# firecracker — единственный поддерживаемый вариант в текущей версии.
# По умолчанию: firecracker
# MICRO_VM_BACKEND=firecracker

# Количество виртуальных CPU для гостя.
# Диапазон: 1–8. По умолчанию: 2
# MICRO_VM_VCPU=2

# Объём RAM гостя в MiB.
# Диапазон: 512–8192. По умолчанию: 1024
# MICRO_VM_MEM_MB=1024

# Включить TAP networking (доступ к сети из гостя через NAT).
# Требуется для: Anthropic API, прокси, загрузок внутри VM.
# false — полностью изолированный гость без сети (максимальная безопасность).
# По умолчанию: true
# MICRO_VM_NET_ENABLED=true

# Имя TAP-интерфейса на хосте.
# Изменяйте только при конфликте с существующими интерфейсами.
# По умолчанию: tap-iclaude
# MICRO_VM_NET_TAP_IFACE=tap-iclaude

# IP хоста в гостевой сети (шлюз для гостя).
# По умолчанию: 172.16.0.1
# MICRO_VM_NET_HOST_IP=172.16.0.1

# IP гостевой VM.
# По умолчанию: 172.16.0.2
# MICRO_VM_NET_GUEST_IP=172.16.0.2

# Использовать снэпшоты для быстрого старта VM.
# true  — повторный запуск ~125ms (снэпшот восстанавливается)
# false — каждый запуск холодный ~1-2s (без снэпшота)
# Внимание: снэпшоты несовместимы с virtiofs; при включении — virtiofs отключается.
# По умолчанию: false
# MICRO_VM_SNAPSHOT_ENABLED=false

# Директория для хранения снэпшотов VM.
# По умолчанию: .nvm-isolated/.claude-isolated/microvm-snapshots/
# MICRO_VM_SNAPSHOT_DIR=

# Путь к rootfs образу (ext4, Alpine Linux ~30MB).
# По умолчанию: .nvm-isolated/.claude-isolated/bin/rootfs.ext4
# Устанавливается автоматически через --install-microvm.
# MICRO_VM_ROOTFS_PATH=

# Путь к ядру Linux для гостя (vmlinux, ~20MB).
# По умолчанию: .nvm-isolated/.claude-isolated/bin/vmlinux
# Устанавливается автоматически через --install-microvm.
# MICRO_VM_KERNEL_PATH=

# Уровень логирования Firecracker VMM.
# debug | info | warn | error
# По умолчанию: warn
# MICRO_VM_LOG_LEVEL=warn

# Передавать настройки прокси в гостевую VM.
# true  — PROXY_URL, PROXY_CA пробрасываются в гостя через TAP (host IP в качестве шлюза)
# false — гость использует прямое соединение
# По умолчанию: true
# MICRO_VM_PROXY_PASS=true

# Монтировать рабочий проект ($PWD) в /workspace внутри VM через virtiofs.
# true  — изменения файлов в VM немедленно видны на хосте (двусторонний mount)
# false — проект не монтируется (read-only mode для максимальной изоляции)
# По умолчанию: true
# MICRO_VM_MOUNT_WORKSPACE=true

# ============================================================
#  ПРИМЕР КОНФИГУРАЦИИ С MICRO-VM
# ============================================================
# # Базовый microVM (без снэпшотов):
# MICRO_VM_ENABLED=true
# MICRO_VM_VCPU=2
# MICRO_VM_MEM_MB=2048
#
# # С быстрым стартом через снэпшоты (virtiofs будет отключён):
# MICRO_VM_ENABLED=true
# MICRO_VM_SNAPSHOT_ENABLED=true
#
# # Максимальная изоляция (без сети):
# MICRO_VM_ENABLED=true
# MICRO_VM_NET_ENABLED=false
# MICRO_VM_MOUNT_WORKSPACE=false

# ============================================================
#  ОТЛАДКА
# ============================================================
# Включить подробный вывод при запуске claude в launch.sh.
# 1 — показывать: путь к бинарю, аргументы, переменные окружения
# (оставить пустым для отключения)
DEBUG_LAUNCH=

# ============================================================
#  ПРИМЕР МИНИМАЛЬНОЙ КОНФИГУРАЦИИ (только прокси)
# ============================================================
# PROXY_URL=https://myuser:mypassword@proxy.company.com:8118
# PROXY_CA=/etc/ssl/company/corporate-ca.crt

# ============================================================
#  ПРИМЕР КОНФИГУРАЦИИ С РОУТЕРОМ (DeepSeek + Ollama)
# ============================================================
# PROXY_URL=https://myuser:mypassword@proxy.company.com:8118
# PROXY_CA=/etc/ssl/company/corporate-ca.crt
#
# export DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# export OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# export GOOGLE_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# CLAUDE_CODE_ENABLE_TASKS=true

# ============================================================
#  ПРИМЕР КОНФИГУРАЦИИ С РОУТЕРОМ (Anthropic + Ollama)
# ============================================================
# Роутинг: main/think/longContext → Anthropic, background → Ollama
# router.json: {"Router": {"default": "anthropic,claude-sonnet-4-6",
#                           "background": "ollama,qwen2.5:7b", ...}}
# Провайдер Anthropic в router.json: "api_key": "${ANTHROPIC_API_KEY}" (без UseBearer)
#
# export ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
#  ПРИМЕР КОНФИГУРАЦИИ С PII PROXY
# ============================================================
# USE_PII_PROXY=true
# # При первом использовании установить: ./iclaude.sh --install-pii-proxy
# #
# # Уровень маскирования (по умолчанию: standard — Presidio NLP + regex):
# # PII_PROXY_MASKING_LEVEL=standard   # полное (NLP + regex) — максимальная защита
# # PII_PROXY_MASKING_LEVEL=secrets    # только regex — быстро, без NLP
# # PII_PROXY_MASKING_LEVEL=off        # без маскирования (только для отладки)
# #
# # Опционально: ограничить диапазон портов (по умолчанию 20000-40000):
# # PII_PROXY_PORT_MIN=30000
# # PII_PROXY_PORT_MAX=35000
