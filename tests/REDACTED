        except Exception:
            pass
    assert script_path, "pii_server script not found"

    if token_sentinel is None:
        os.environ.pop('PII_PROXY_MASK_TOKEN', None)
    else:
        os.environ['PII_PROXY_MASK_TOKEN'] = token_sentinel

    os.environ['PII_PROXY_MASKING_LEVEL'] = level
    os.environ['PII_PROXY_LOG_LEVEL'] = 'info'
    os.environ['ANTHROPIC_UPSTREAM_URL'] = 'http://localhost:19999'
    os.environ.pop('ICLAUDE_SESSION_ID', None)

    spec = importlib.util.spec_from_file_location('pii_mod_' + level + str(id(token_sentinel)), script_path)
    mod = REDACTEDdule_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

