# Working directory (should not be in repository)
/opt/vless/

# Python cache (global)
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment files
.env
*.env.local
*.env.production

# Backup files
*.bak
*.tar.gz

# Temporary files
*.tmp
*.temp
*~
.*.swp
.*.swo
tmp

# Session-specific readable files (statusline generated)
# Includes both TOON format (.toon) and legacy text format (.txt)
.claude-sessions/

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.iml

# Log files
*.log
logs/

# User data
users.json
*.key
*.pem
qr_codes/

# Configuration file (proxy, Claude Code settings, debug flags)
.claude_config
.claude_config.bak
.claude_proxy_credentials  # Legacy filename (for backward compatibility)
scripts/.claude_config
scripts/.claude_proxy_credentials  # Legacy

# microVM guest environment file — written to $PWD at runtime, may contain credentials
# (HTTPS_PROXY with embedded password, ANTHROPIC_BASE_URL with port info)
.iclaude-guest-env.sh

# microVM v2 workspace artifacts — per-session, auto-cleaned by stop_microvm()
.iclaude-ssh/
.iclaude-guest-ready

# microVM v2 block images — generated at --install-microvm, not committed
# nvm.img: pre-built NVM snapshot (read-only per-session /dev/vdb)
# workspace-*.img: per-session workspace (auto-cleaned by stop_microvm)
.nvm-isolated/.claude-isolated/bin/nvm.img
.nvm-isolated/.claude-isolated/bin/*.img

# Isolated NVM environment - temporary/cache files only
.nvm-isolated/.cache/
.nvm-isolated/.npm/
.nvm-isolated/.nvm/.cache/
.nvm-isolated/npm-global/.npm/

# Node.js runtimes are no longer vendored in git: the node binary exceeds
# GitHub's 100 MB file limit (node 22 ≈ 119 MB) and bloats history. They live
# on disk only and are reinstalled from the lockfile via nvm or the node-TLS
# fetcher (scripts/fetch-node.js, ensure_isolated_node_engine).
.nvm-isolated/versions/node/

# Per-project config homes (runtime state, ICLAUDE_HOME_MODE=per-project)
.claude-homes/

# Isolated Claude Code configuration (session data)
# Ignore session data, but keep skills and templates
# NOTE: CLAUDE.md is in project root (not here) to avoid user-level memory pollution
.nvm-isolated/.claude-isolated/*
!.nvm-isolated/.claude-isolated/commands/
!.nvm-isolated/.claude-isolated/commands/**
!.nvm-isolated/.claude-isolated/skills/
!.nvm-isolated/.claude-isolated/skills/**
!.nvm-isolated/.claude-isolated/agents/
!.nvm-isolated/.claude-isolated/agents/**
!.nvm-isolated/.claude-isolated/CHANGELOG-v7.0.md
!.nvm-isolated/.claude-isolated/mcp/
!.nvm-isolated/.claude-isolated/mcp/**
# Launch-time render of mcp/iwiki.json (adds the optional code-graph keys)
.nvm-isolated/.claude-isolated/mcp/*.runtime.json
!.nvm-isolated/.claude-isolated/settings.json
!.nvm-isolated/.claude-isolated/hooks/
!.nvm-isolated/.claude-isolated/hooks/**
!.nvm-isolated/.claude-isolated/commands/
!.nvm-isolated/.claude-isolated/commands/**
!.nvm-isolated/.claude-isolated/plugins/
!.nvm-isolated/.claude-isolated/plugins/**
# Exclude plugin cache and marketplace dirs (contain nested git repos, regenerable via install)
.nvm-isolated/.claude-isolated/plugins/cache/
.nvm-isolated/.claude-isolated/plugins/marketplaces/
.nvm-isolated/.claude-isolated/plugins/data/
# Exclude plugin runtime state (contains absolute paths, machine-specific, regenerated on install)
.nvm-isolated/.claude-isolated/plugins/installed_plugins.json
.nvm-isolated/.claude-isolated/plugins/known_marketplaces.json
.nvm-isolated/.claude-isolated/plugins/install-counts-cache.json
.nvm-isolated/.claude-isolated/plugins/plugin-catalog-cache.json
# Runtime timestamp rewritten on every launch (pure cache, churns git)
.nvm-isolated/.claude-isolated/plugins/.last_inuse_sweep
!.nvm-isolated/.claude-isolated/CLAUDE.md
# Re-exclude Python bytecode inside hooks/ (negation above overrides global __pycache__/ rule)
.nvm-isolated/.claude-isolated/hooks/__pycache__/
.nvm-isolated/.claude-isolated/hooks/**/*.pyc

# Router configuration (only example in git, actual config ignored)
!.nvm-isolated/.claude-isolated/router.json.example
!.nvm-isolated/.claude-isolated/router.json

# Plugin manifest (declarative list of plugins to install after git clone)
!.nvm-isolated/.claude-isolated/plugins-manifest.json

# Status line scripts and themes (Phase 1 & 2)
!.nvm-isolated/.claude-isolated/scripts/
!.nvm-isolated/.claude-isolated/scripts/**
!.nvm-isolated/.claude-isolated/themes/
!.nvm-isolated/.claude-isolated/themes/**

# Prevent accidental commit of runtime router config
.claude-code-router/
# EXCEPTION: track ONLY the custom transformer plugins shipped with the repo.
# Re-include the dir for traversal, re-ignore its runtime contents (config.json,
# *.pid), then re-include the plugins/*.js — so config.json and the PID file stay
# ignored while x-project-id.js / ollama-reasoning.js are tracked.
!.nvm-isolated/.claude-isolated/.claude-code-router/
.nvm-isolated/.claude-isolated/.claude-code-router/*
!.nvm-isolated/.claude-isolated/.claude-code-router/plugins/
!.nvm-isolated/.claude-isolated/.claude-code-router/plugins/*.js

# Backup files (any location, any extension with backup suffix)
*.backup
*.backup-*
**/*.backup
**/*.backup-*

# NPM packages (tracked via lockfile only)
# Exclude node_modules to prevent committing minified JavaScript artifacts
.nvm-isolated/npm-global/lib/node_modules/
.nvm-isolated/versions/node/*/lib/node_modules/

# EXCEPTION: Allow @anthropic-ai packages (required for isolated environment)
!.nvm-isolated/npm-global/lib/node_modules/@anthropic-ai/
!.nvm-isolated/npm-global/lib/node_modules/@anthropic-ai/**

# Exclude large binaries exceeding GitHub's 100MB limit
.nvm-isolated/npm-global/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe

# Keep only package structure
!.nvm-isolated/npm-global/lib/.gitkeep


# Oh My Posh symlink (created by install, not committed)
.nvm-isolated/npm-global/bin/oh-my-posh

# Note: Platform-specific binaries (oh-my-posh-*) ARE committed to git
# Claude Code Agent Workspace - ignore most content, keep skills/
# Memory is stored in isolated config: .nvm-isolated/.claude-isolated/projects/*/memory/
.claude/*
!.claude/skills
!.claude/skills/**
.claude/sessions

# Code review runtime artifacts (review reports, TOON output)
# Covered by .claude/* above; explicit entry for documentation clarity
.claude/code-review/

# TOON runtime artifacts — session files from all skills (code-review, researcher, etc.)
# All skills MUST write .toon files to .claude/<skill>/ — never to project root
# This rule catches violations (files written to wrong location)
*.toon

# Test fixtures with mock secrets (not committed)
tests/fixtures/

# Claude Code Agent Workspace
.claude/workspace/
.claude/plans/

# PII proxy audit logs (auto-added by iclaude PII proxy)
.claude/pii/
.superpowers
.worktrees/
.mcp.json
.nvm-isolated/npm-global/lib/node_modules/@anthropic-ai/claude-code-linux-x64/
