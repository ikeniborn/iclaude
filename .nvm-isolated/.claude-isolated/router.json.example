{
  "_comment": "Claude Code Router v2.0.0 configuration template. Copy to router.json and fill in your API keys.",
  "_docs": "https://github.com/musistudio/claude-code-router | docs/ROUTER.md",
  "_anthropic_note": "CCR requires a real Anthropic API key (sk-ant-api03-...) — subscription OAuth tokens are NOT accepted by api.anthropic.com. Get a key: https://console.anthropic.com/settings/keys. Without a key, use Ollama/DeepSeek/OpenRouter for all roles.",

  "PORT": 3456,
  "HOST": "127.0.0.1",
  "LOG": true,
  "LOG_LEVEL": "info",
  "API_TIMEOUT_MS": 60000,

  "Providers": [
    {
      "_comment_anthropic": "Anthropic API — requires ANTHROPIC_API_KEY (real API key, NOT subscription OAuth token). Set in .claude_config: export ANTHROPIC_API_KEY=sk-ant-api03-...",
      "name": "anthropic",
      "api_base_url": "https://api.anthropic.com/v1/messages",
      "api_key": "${ANTHROPIC_API_KEY}",
      "models": ["claude-sonnet-4-6", "claude-opus-4-6", "claude-haiku-4-5"],
      "transformer": {
        "use": ["anthropic"]
      }
    },
    {
      "name": "deepseek",
      "api_base_url": "https://api.deepseek.com/chat/completions",
      "api_key": "${DEEPSEEK_API_KEY}",
      "models": ["deepseek-chat", "deepseek-reasoner"],
      "transformer": {
        "use": ["deepseek"],
        "deepseek-chat": {
          "use": ["tooluse"]
        }
      }
    },
    {
      "name": "openrouter",
      "api_base_url": "https://openrouter.ai/api/v1/chat/completions",
      "api_key": "${OPENROUTER_API_KEY}",
      "models": [
        "google/gemini-2.5-pro-preview",
        "anthropic/claude-3.5-sonnet",
        "perplexity/sonar-online"
      ],
      "transformer": {
        "use": ["openrouter"]
      }
    },
    {
      "_comment_ollama": "Ollama local — трансформер не нужен (OpenAI-compatible API нативно).",
      "_comment_ollama_params": "num_ctx и temperature задаются через Modelfile, не через CCR (sampling transformer не передаёт num_ctx). Пример Modelfile: FROM qwen2.5-coder:7b / PARAMETER num_ctx 65536 / PARAMETER temperature 0.2 / PARAMETER top_p 0.9 / PARAMETER top_k 40 — затем: ollama create qwen2.5-coder-tuned -f Modelfile",
      "name": "ollama",
      "api_base_url": "http://localhost:11434/v1/chat/completions",
      "api_key": "ollama",
      "models": ["qwen2.5-coder-tuned", "llama3.1-tuned"]
    },
    {
      "_comment_ollama_cloud": "Ollama Cloud — крупные модели на серверах Ollama. Требуют: ollama signin. num_ctx управляется серверной стороной.",
      "name": "ollama-cloud",
      "api_base_url": "http://localhost:11434/v1/chat/completions",
      "api_key": "ollama",
      "models": ["qwen3.5:397b-cloud", "qwen3-coder-next:cloud", "qwen3-vl:235b-cloud"],
      "transformer": {
        "use": [
          ["sampling", { "temperature": 0.2, "top_p": 0.9, "top_k": 40 }]
        ],
        "qwen3-vl:235b-cloud": {
          "use": [
            ["sampling", { "temperature": 0.5, "top_p": 0.95 }]
          ]
        }
      }
    },
    {
      "name": "gemini",
      "api_base_url": "https://generativelanguage.googleapis.com/v1beta/models/",
      "api_key": "${GOOGLE_API_KEY}",
      "models": ["gemini-2.5-flash", "gemini-2.5-pro"],
      "transformer": {
        "use": ["gemini"]
      }
    }
  ],

  "Router": {
    "default": "deepseek,deepseek-chat",
    "background": "ollama,qwen2.5-coder:7b",
    "think": "deepseek,deepseek-reasoner",
    "longContext": "openrouter,google/gemini-2.5-pro-preview",
    "longContextThreshold": 60000,
    "webSearch": "openrouter,perplexity/sonar-online",
    "image": "openrouter,anthropic/claude-3.5-sonnet"
  },

  "_comment_ollama_cloud_router": "Пример Router для Ollama Cloud (замените секции выше при необходимости)",
  "_Router_ollama_cloud_example": {
    "default": "ollama-cloud,qwen3.5:397b-cloud",
    "background": "ollama-cloud,qwen3-coder-next:cloud",
    "think": "ollama-cloud,qwen3.5:397b-cloud",
    "longContext": "ollama-cloud,qwen3.5:397b-cloud",
    "longContextThreshold": 60000,
    "image": "ollama-cloud,qwen3-vl:235b-cloud"
  }
}
