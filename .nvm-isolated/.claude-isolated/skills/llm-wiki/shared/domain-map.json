  "cross_domain_rules": {
    "description": "Правила для сущностей, встречающихся в нескольких доменах",
    "rules": [
      {
        "entity_pattern": "ClickHouse",
        "primary_domain": "базы-данных",
        "primary_page": "базы-данных/субд/clickhouse.md",
        "cross_references": [
          "ростелеком"
        ],
        "rule": "Основная страница в базы-данных/субд/clickhouse.md. В ростелеком-страницах — WikiLink [[clickhouse]] без дублирования контента."
      },
      {
        "entity_pattern": "GreenPlum|Greenplum|ГП",
        "primary_domain": "базы-данных",
        "primary_page": "базы-данных/субд/greenplum.md",
        "cross_references": [
          "ростелеком"
        ],
        "rule": "Основная страница в базы-данных. Поток ГП→ЦХД описывается в ростелеком/системная-архитектура."
      }
    ]
  },
  "special_source_types": {
    "daily_notes": {
      "path_pattern": "vaults/Work/!Daily/",
      "domain_detection": "автоматически по ключевым словам и упоминаемым системам",
      "priority": "low",
      "notes": "Daily notes могут содержать сущности любого домена. Определять домен по содержимому."
    },
    "hld_documents": {
      "path_pattern": "vaults/Work/Ростелеком/Системная архитектура/HLD/",
      "domain_detection": "ростелеком",
      "priority": "high",
      "notes": "HLD-документы — авторитетный источник. При конфликте с daily notes — приоритет HLD."
    }
  }
}
