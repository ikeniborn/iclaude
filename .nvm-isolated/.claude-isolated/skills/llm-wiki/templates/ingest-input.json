{
  "description": "Шаблоны входных данных для операций llm-wiki",
  "operations": {
    "ingest": {
      "operation": "ingest",
      "source_path": "{{source_path: string — путь к файлу-источнику}}",
      "options": {
        "dry_run": false
      }
    },
    "ingest_dry_run": {
      "operation": "ingest",
      "source_path": "{{source_path: string}}",
      "options": {
        "dry_run": true
      }
    },
    "query": {
      "operation": "query",
      "question": "{{question: string — вопрос на русском}}"
    },
    "query_save": {
      "operation": "query",
      "question": "{{question: string}}",
      "options": {
        "save": true
      }
    },
    "lint_section": {
      "operation": "lint",
      "section": "{{section: enum ии|ростелеком|базы-данных}}"
    },
    "lint_all": {
      "operation": "lint"
    },
    "init": {
      "operation": "init",
      "section": "{{section: enum ии|ростелеком|базы-данных}}",
      "options": {
        "dry_run": false,
        "batch_size": 10
      }
    }
  }
}
