{
  "$comment": "Base template for generated SKILL.md frontmatter and structure with decomposition support",
  "skill_template": {
    "frontmatter": {
      "$comment": "Only official Claude Code SKILL.md fields allowed here. Docs: https://code.claude.com/docs/en/skills",
      "name": "{{name: string}}",
      "description": "{{description: string}}",
      "user-invocable": "{{user_invocable: boolean}}",
      "context": "{{context: enum fork|null, optional, use fork for heavy processing/many tool calls}}",
      "agent": "{{agent: enum Explore|Plan|general-purpose|Bash|null, optional, Explore=read-only Haiku; Plan=planning read-only; general-purpose=writes+complex (default); Bash=terminal; NEVER use Validation}}",
      "allowed-tools": "{{allowed_tools: string, optional}}"
    },
    "metadata_comment": {
      "$comment": "Non-official metadata goes in HTML comment AFTER closing ---, NOT in frontmatter",
      "format": "<!-- version: 1.0.0 | tags: {{tags}} | dependencies: {{dependencies}} -->",
      "fields": {
        "version": "1.0.0",
        "tags": ["{{tag: string}}"],
        "dependencies": ["{{dependency: string}}"]
      }
    },
    "markdown_sections": [
      "# {{Skill Name}}",
      "",
      "## When to Use",
      "",
      "## How It Works",
      "",
      "### Step 1: {{First Step Title}}",
      "",
      "### Step 2: {{Second Step Title}}",
      "",
      "## Output Format",
      "",
      "### Workflow Integration (JSON)",
      "",
      "## Examples",
      "",
      "{{examples_list}}",
      "",
      "## Rules",
      "",
      "{{rules_section}}",
      "",
      "## Templates",
      "",
      "{{templates_section}}",
      "",
      "## Schemas",
      "",
      "## Workflow Integration",
      "",
      "### Input Dependencies",
      "",
      "### Output Consumers"
    ],
    "examples_generation": {
      "$comment": "Configuration for generating multiple examples",
      "count": "{{examples_count: integer, min 2, max 5, default 3}}",
      "categories": [
        "basic-usage",
        "advanced-scenario",
        "error-handling"
      ],
      "format": "- **@example:{{filename}}.md** - {{description}}"
    },
    "rules_generation": {
      "$comment": "Configuration for generating rules/best-practices.md",
      "enabled": true,
      "filename": "best-practices.md",
      "sections": [
        "Best Practices",
        "Common Pitfalls",
        "Performance Tips"
      ],
      "format": "- **@rules:{{filename}}** - {{description}}"
    },
    "templates_section": {
      "$comment": "Configuration for templates references",
      "format": "- **@template:{{filename}}.json** - {{description}}"
    }
  }
}
