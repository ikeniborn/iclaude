{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rules-template.schema.json",
  "title": "Rules Template Schema",
  "description": "JSON Schema for skill rules/best-practices.md template",
  "type": "object",
  "required": ["skill_name", "rules_structure"],
  "properties": {
    "skill_name": {
      "type": "string",
      "description": "Name of the skill",
      "minLength": 1
    },
    "rules_structure": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "description": "Array of rule sections (Best Practices, Common Pitfalls, Performance Tips)",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["title", "rules"],
                "properties": {
                  "title": {
                    "type": "string",
                    "const": "Best Practices"
                  },
                  "rules": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["rule", "rationale"],
                      "properties": {
                        "rule": {
                          "type": "string",
                          "description": "Best practice guideline"
                        },
                        "rationale": {
                          "type": "string",
                          "description": "Why this practice matters"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": ["title", "pitfalls"],
                "properties": {
                  "title": {
                    "type": "string",
                    "const": "Common Pitfalls"
                  },
                  "pitfalls": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["pitfall", "consequence", "solution"],
                      "properties": {
                        "pitfall": {
                          "type": "string",
                          "description": "Common mistake"
                        },
                        "consequence": {
                          "type": "string",
                          "description": "What goes wrong"
                        },
                        "solution": {
                          "type": "string",
                          "description": "How to avoid this pitfall"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": ["title", "tips"],
                "properties": {
                  "title": {
                    "type": "string",
                    "const": "Performance Tips"
                  },
                  "tips": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["tip", "impact"],
                      "properties": {
                        "tip": {
                          "type": "string",
                          "description": "Performance optimization technique"
                        },
                        "impact": {
                          "type": "string",
                          "description": "Expected improvement"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "markdown_template": {
      "type": "object",
      "description": "Markdown formatting template (optional)",
      "properties": {
        "format": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
