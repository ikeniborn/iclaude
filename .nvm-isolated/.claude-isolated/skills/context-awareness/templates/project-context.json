{
  "$comment": "Template for project context detection output",
  "project_context": {
    "language": "{{language: python|javascript|typescript|go|rust|bash}}",
    "framework": "{{framework: fastapi|django|react|express|none}}",
    "test_framework": "{{test_framework: pytest|jest|go_test|none}}",
    "has_prd": "{{has_prd: boolean}}",
    "prd_path": "{{prd_path: string|null}}",
    "has_docs": "{{has_docs: boolean}}",
    "docs_llms_path": "{{docs_llms_path: string|null}}",
    "syntax_command": "{{syntax_command: from the Syntax Command Lookup table in SKILL.md}}",
    "lint_command": "{{lint_command: optional}}",
    "code_style": "{{code_style: pep8|prettier|gofmt|none}}",
    "wiki_initialized": "{{wiki_initialized: boolean}}",
    "wiki_domain": "{{wiki_domain: string|null}}",
    "wiki_summary": "{{wiki_summary: string|null}}",
    "code_graph_available": "{{code_graph_available: boolean}}",
    "code_graph_domain": "{{code_graph_domain: string|null}}",
    "code_graph_state": "{{code_graph_state: ready|missing_snapshot|disabled|source_unavailable|dirty|rebuilding|failed|incompatible|null}}",
    "code_graph_fresh": "{{code_graph_fresh: boolean}}",
    "task_topic": "{{task_topic: string|null}}",
    "task_page_slug": "{{task_page_slug: reference/tasks/<topic>|null}}",
    "task_page_found": "{{task_page_found: boolean}}",
    "task_lifecycle": "{{task_lifecycle: in-progress|blocked|completion-pending|done|null}}",
    "task_delivery_pending": "{{task_delivery_pending: boolean}}",
    "detected_files": {
      "config": ["{{config_files}}"],
      "source_dirs": ["{{source_directories}}"],
      "test_dirs": ["{{test_directories}}"]
    }
  }
}
