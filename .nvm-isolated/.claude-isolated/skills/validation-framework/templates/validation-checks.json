{
  "$comment": "Validation checks configuration for different validator types",
  "validators": {
    "acceptance_criteria": {
      "type": "acceptance",
      "description": "Verify acceptance criteria from task_plan are met",
      "checks": [
        {
          "criterion": "Login endpoint returns 200 OK with valid JWT",
          "check_type": "response_code",
          "expected": 200
        },
        {
          "criterion": "User model has email field",
          "check_type": "file_contains",
          "file": "src/models/user.py",
          "pattern": "email.*=.*models\\.CharField"
        }
      ]
    },
    "test_suite": {
      "type": "tests",
      "description": "Run validation commands and verify test results",
      "commands": [
        "pytest tests/ -v",
        "npm run type-check",
        "cargo test"
      ],
      "parsers": {
        "pytest": {
          "pattern": "(\\d+) passed.*?(\\d+) failed",
          "success_exit_code": 0
        },
        "jest": {
          "pattern": "Tests:\\s+(\\d+) failed,\\s+(\\d+) passed",
          "success_exit_code": 0
        }
      }
    },
    "completion_status": {
      "type": "completion",
      "description": "Verify task completion status",
      "checks": [
        {
          "check": "all_critical_files_modified",
          "description": "All files in critical_files with change_type=modify were updated"
        },
        {
          "check": "all_implementation_steps_completed",
          "description": "All implementation steps executed"
        },
        {
          "check": "no_blocking_errors",
          "description": "No critical errors during execution"
        }
      ],
      "thresholds": {
        "min_completion": 0.8
      }
    }
  }
}
