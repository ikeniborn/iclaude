{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "researcher-agent/output.schema.json",
  "title": "Researcher Agent Output",
  "description": "Результат исследования (research.toon)",
  "type": "object",
  "required": ["research_results"],
  "additionalProperties": false,
  "properties": {
    "research_results": {
      "type": "object",
      "required": [
        "project_context",
        "codebase_analysis",
        "architecture_analysis",
        "risk_assessment",
        "external_docs",
        "recommendations"
      ],
      "additionalProperties": false,
      "properties": {
        "project_context": {
          "type": "object",
          "description": "Контекст проекта (определяется автоматически)",
          "required": ["language"],
          "properties": {
            "language": {
              "type": "string",
              "description": "Основной язык проекта",
              "examples": ["bash", "python", "typescript", "go"]
            },
            "framework": {
              "type": ["string", "null"],
              "description": "Фреймворк/библиотека (null если нет)",
              "examples": ["none", "express", "fastapi", null]
            },
            "entry_point": {
              "type": ["string", "null"],
              "description": "Основной entry point проекта",
              "examples": ["iclaude.sh", "src/index.ts", "main.py"]
            },
            "architecture_style": {
              "type": ["string", "null"],
              "description": "Стиль архитектуры",
              "examples": ["modular", "monolith", "microservices", "MVC"]
            }
          }
        },
        "codebase_analysis": {
          "type": "object",
          "required": ["relevant_files"],
          "properties": {
            "relevant_files": {
              "description": "Список релевантных файлов. Строка '<<TOON:relevant_files>>' если >= 5 файлов и TOON-блок встроен в файл. Массив объектов если < 5.",
              "oneOf": [
                {
                  "type": "string",
                  "const": "<<TOON:relevant_files>>",
                  "description": "Ссылка на TOON-блок в файле (используется если >= 5 файлов)"
                },
                {
                  "type": "array",
                  "description": "JSON-массив (используется если < 5 файлов)",
                  "items": {
                    "type": "object",
                    "required": ["path", "relevance", "reason"],
                    "properties": {
                      "path": {
                        "type": "string",
                        "description": "Путь к файлу относительно project root"
                      },
                      "relevance": {
                        "type": "string",
                        "enum": ["high", "medium", "low"]
                      },
                      "reason": {
                        "type": "string",
                        "description": "Краткое объяснение (< 60 символов)"
                      }
                    }
                  }
                }
              ]
            },
            "reusable_components": {
              "type": "array",
              "description": "Существующие компоненты которые можно переиспользовать",
              "items": {
                "type": "object",
                "required": ["name", "file", "description"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Имя функции/модуля/класса",
                    "examples": ["parse_args()", "validate_proxy_url()"]
                  },
                  "file": {
                    "type": "string",
                    "description": "Файл где определён компонент"
                  },
                  "description": {
                    "type": "string",
                    "description": "Как его использовать для текущей задачи"
                  }
                }
              }
            },
            "existing_implementations": {
              "type": "array",
              "description": "Существующие реализации похожей функциональности",
              "items": {
                "type": "object",
                "properties": {
                  "description": { "type": "string" },
                  "file": { "type": "string" },
                  "pattern": { "type": "string" }
                }
              }
            }
          }
        },
        "architecture_analysis": {
          "type": "object",
          "required": ["affected_components"],
          "properties": {
            "affected_components": {
              "type": "array",
              "description": "Компоненты/директории которые будут затронуты",
              "items": { "type": "string" }
            },
            "integration_points": {
              "type": "array",
              "description": "Точки интеграции между компонентами",
              "items": { "type": "string" }
            },
            "dependency_chain": {
              "type": ["string", "null"],
              "description": "Цепочка зависимостей (A → B → C формат)"
            }
          }
        },
        "risk_assessment": {
          "type": "object",
          "required": ["breaking_changes_potential", "risks"],
          "properties": {
            "breaking_changes_potential": {
              "type": "string",
              "enum": ["none", "low", "medium", "high"],
              "description": "Потенциал breaking changes"
            },
            "risks": {
              "type": "array",
              "description": "Список рисков",
              "items": {
                "type": "object",
                "required": ["id", "description", "severity", "mitigation"],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Идентификатор риска (R1, R2, ...)"
                  },
                  "description": { "type": "string" },
                  "severity": {
                    "type": "string",
                    "enum": ["low", "medium", "high", "critical"]
                  },
                  "mitigation": {
                    "type": "string",
                    "description": "Как избежать/обработать риск"
                  }
                }
              }
            }
          }
        },
        "external_docs": {
          "type": "object",
          "required": ["context7_status"],
          "properties": {
            "context7_status": {
              "type": "string",
              "enum": [
                "NO_LIBRARIES_DETECTED",
                "PLUGIN_NOT_AVAILABLE",
                "DOCS_FOUND",
                "SKIPPED"
              ],
              "description": "Статус Context7 вызова"
            },
            "docs_found": {
              "type": "array",
              "description": "Найденная документация",
              "items": {
                "type": "object",
                "properties": {
                  "library": { "type": "string" },
                  "topic": { "type": "string" },
                  "key_insights": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "recommendations": {
          "type": "object",
          "required": ["complexity_hint", "key_insights"],
          "properties": {
            "complexity_hint": {
              "type": "string",
              "enum": ["minimal", "standard", "complex"],
              "description": "Подсказка сложности для Planning Agent"
            },
            "key_insights": {
              "type": "array",
              "description": "Ключевые наблюдения для Planning Agent",
              "items": { "type": "string" },
              "minItems": 1
            }
          }
        }
      }
    }
  }
}
