{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "planning-agent/output.schema.json",
  "title": "Planning Agent Output",
  "description": "План выполнения задачи (plan.toon)",
  "type": "object",
  "required": ["schema_version", "research_schema_version", "execution_plan"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.1.0",
      "description": "Версия схемы plan.toon"
    },
    "research_schema_version": {
      "type": "string",
      "description": "Версия schema_version из research.toon — для cross-reference validation. 'unknown' если research.toon не содержал schema_version."
    },
    "execution_plan": {
      "type": "object",
      "required": ["metadata", "phases", "research_references"],
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["task_description", "complexity", "total_phases", "estimated_steps"],
          "properties": {
            "task_description": {
              "type": "string",
              "description": "Описание задачи (из input.toon)"
            },
            "complexity": {
              "type": "string",
              "enum": ["minimal", "standard", "complex"],
              "description": "Из research.recommendations.complexity_hint"
            },
            "total_phases": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Общее число фаз"
            },
            "estimated_steps": {
              "type": "integer",
              "minimum": 1,
              "description": "Суммарное число шагов во всех фазах"
            }
          }
        },
        "phases": {
          "type": "array",
          "description": "Список фаз выполнения",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["phase_number", "phase_name", "risk", "files_to_change", "validation"],
            "properties": {
              "phase_number": {
                "type": "integer",
                "minimum": 1
              },
              "phase_name": {
                "type": "string",
                "description": "Короткое название фазы",
                "examples": ["CLI + Help", "Core Implementation", "Tests"]
              },
              "risk": {
                "type": "string",
                "enum": ["low", "medium", "high"],
                "description": "Уровень риска фазы (high → approval gate в Executor)"
              },
              "steps": {
                "description": "Шаги фазы. TOON-ссылка если >= 5 шагов, JSON-массив если < 5.",
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^<<TOON:phase_\\d+_steps>>$",
                    "description": "TOON-ссылка (используется если >= 5 шагов)"
                  },
                  {
                    "type": "array",
                    "description": "JSON-массив шагов (используется если < 5 шагов)",
                    "items": {
                      "type": "object",
                      "required": ["step_number", "description", "action", "file"],
                      "properties": {
                        "step_number": { "type": "integer" },
                        "description": {
                          "type": "string",
                          "description": "Что делает шаг (может включать 'Reuse: X from Y' и 'Mitigation: Z')"
                        },
                        "action": {
                          "type": "string",
                          "description": "Конкретное действие (глагол + детали)"
                        },
                        "file": {
                          "type": "string",
                          "description": "Файл для изменения"
                        },
                        "validation": {
                          "type": ["string", "null"],
                          "description": "Команда проверки после шага"
                        }
                      }
                    }
                  }
                ]
              },
              "files_to_change": {
                "type": "array",
                "description": "Файлы изменяемые в этой фазе",
                "items": { "type": "string" }
              },
              "validation": {
                "type": "string",
                "description": "Финальная команда валидации фазы"
              },
              "commit_message": {
                "type": ["string", "null"],
                "description": "Сообщение коммита для этой фазы (Conventional Commits формат)",
                "examples": ["feat(cli): add --list-sessions flag"]
              }
            }
          }
        },
        "files_to_change": {
          "description": "Сводный список всех файлов. TOON-ссылка если >= 5 файлов.",
          "oneOf": [
            {
              "type": "string",
              "const": "<<TOON:files_to_change>>",
              "description": "TOON-ссылка (используется если >= 5 файлов)"
            },
            {
              "type": "array",
              "description": "JSON-массив (используется если < 5 файлов)",
              "items": {
                "type": "object",
                "required": ["file", "action", "phase"],
                "properties": {
                  "file": { "type": "string" },
                  "action": {
                    "type": "string",
                    "enum": ["create", "modify", "delete"]
                  },
                  "phase": {
                    "type": "integer",
                    "description": "Номер фазы"
                  }
                }
              }
            }
          ]
        },
        "research_references": {
          "type": "object",
          "required": ["reusable_components_used", "risks_mitigated"],
          "description": "Ссылки на данные из research.toon (обязательно заполнять)",
          "properties": {
            "reusable_components_used": {
              "type": "array",
              "description": "Компоненты из research.codebase_analysis.reusable_components использованные в плане",
              "items": {
                "type": "string",
                "description": "Формат: '{name} from {file}'",
                "examples": ["parse_args() from lib/command/args.sh"]
              }
            },
            "risks_mitigated": {
              "type": "array",
              "description": "Риски из research.risk_assessment.risks учтённые в плане",
              "items": {
                "type": "string",
                "description": "Формат: '{id}: {description} → {mitigation}'",
                "examples": ["R1: Empty session-env/ → print 'No active sessions' message"]
              }
            },
            "missing_info": {
              "type": "array",
              "description": "Информация отсутствующая в research (агент продолжил с assumptions)",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "execution_plan": {
        "metadata": {
          "task_description": "Добавить флаг --list-sessions в iclaude.sh",
          "complexity": "minimal",
          "total_phases": 2,
          "estimated_steps": 4
        },
        "phases": [
          {
            "phase_number": 1,
            "phase_name": "CLI + Help",
            "risk": "low",
            "steps": [
              {
                "step_number": 1,
                "description": "Parse --list-sessions flag. Reuse: parse_args() from lib/command/args.sh",
                "action": "Add case '--list-sessions)' to switch in parse_args()",
                "file": "lib/command/args.sh",
                "validation": "bash -n lib/command/args.sh"
              },
              {
                "step_number": 2,
                "description": "Update help text",
                "action": "Add '--list-sessions  List all active Claude Code sessions' to help output",
                "file": "lib/command/help.sh",
                "validation": "bash -n lib/command/help.sh"
              }
            ],
            "files_to_change": ["lib/command/args.sh", "lib/command/help.sh"],
            "validation": "bash -n iclaude.sh",
            "commit_message": "feat(cli): add --list-sessions flag"
          }
        ],
        "files_to_change": [
          {"file": "lib/command/args.sh", "action": "modify", "phase": 1},
          {"file": "lib/command/help.sh", "action": "modify", "phase": 1},
          {"file": "lib/context/sessions.sh", "action": "create", "phase": 2}
        ],
        "research_references": {
          "reusable_components_used": [
            "parse_args() from lib/command/args.sh",
            "show_help() from lib/command/help.sh"
          ],
          "risks_mitigated": [
            "R1: Empty session-env/ → print 'No active sessions' message",
            "R2: Unknown session format → defensive parsing with fallback"
          ]
        }
      }
    }
  ]
}
