{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deep-research-agent/input.schema.json",
  "title": "Deep Research Agent Input",
  "description": "Входная задача для Deep Research Agent (deep-research-request.toon)",
  "type": "object",
  "required": ["deep_research_input"],
  "additionalProperties": false,
  "properties": {
    "deep_research_input": {
      "type": "object",
      "required": ["query", "depth", "max_sources", "output_format", "caller"],
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 10,
          "description": "Вопрос или тема для веб-исследования",
          "examples": [
            "claude-sonnet-4-6 API breaking changes 2026",
            "NVM isolated environments CI/CD best practices"
          ]
        },
        "depth": {
          "type": "string",
          "enum": ["shallow", "standard", "deep"],
          "description": "Уровень глубины исследования: shallow (~1 мин), standard (~3 мин), deep (~8 мин)"
        },
        "max_sources": {
          "type": "integer",
          "minimum": 3,
          "maximum": 30,
          "description": "Максимальное количество источников для фетчинга"
        },
        "focus_areas": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Конкретные области для прицельного исследования (пусто = всё)",
          "examples": [
            ["api_changes", "migration", "deprecations"],
            ["web_research"],
            ["model_id", "pricing", "api_compatibility"]
          ]
        },
        "output_format": {
          "type": "string",
          "enum": ["summary", "detailed", "structured"],
          "description": "Формат выходных данных"
        },
        "caller": {
          "type": "string",
          "enum": ["researcher", "user", "orchestrator"],
          "description": "Кто вызвал агента: user → запрашивает подтверждение; researcher/orchestrator → запускается сразу"
        },
        "hints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefer_official_docs": {
              "type": "boolean",
              "default": true,
              "description": "Приоритизировать официальную документацию над блогами"
            },
            "recency_filter": {
              "type": ["string", "null"],
              "description": "Фильтр по дате публикации: 'last 6 months', 'last 12 months', null",
              "examples": ["last 6 months", "last 12 months", null]
            },
            "language": {
              "type": "string",
              "default": "en",
              "description": "Язык источников для поиска"
            },
            "exclude_domains": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Домены для исключения из результатов",
              "examples": [["reddit.com", "stackoverflow.com"]]
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "deep_research_input": {
        "query": "claude-sonnet-4-6 API features prompt caching 2026 official documentation",
        "depth": "standard",
        "max_sources": 10,
        "focus_areas": ["model_id", "api_compatibility", "pricing"],
        "output_format": "structured",
        "caller": "researcher",
        "hints": {
          "prefer_official_docs": true,
          "recency_filter": "last 6 months",
          "language": "en",
          "exclude_domains": []
        }
      }
    }
  ]
}
