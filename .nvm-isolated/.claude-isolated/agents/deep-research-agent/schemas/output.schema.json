{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deep-research-agent/output.schema.json",
  "title": "Deep Research Agent Output",
  "description": "Выходные данные Deep Research Agent (deep-research-results.toon). Для >= 8 источников поле 'sources' заменяется TOON-ссылкой '<<TOON:sources>>'.",
  "type": "object",
  "required": ["deep_research_results"],
  "additionalProperties": false,
  "properties": {
    "deep_research_results": {
      "type": "object",
      "required": ["metadata", "key_findings", "detailed_findings", "contradictions", "gaps", "sources", "recommendations"],
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["query", "depth", "sources_found", "sources_fetched", "search_queries_used", "timestamp", "duration_estimate"],
          "additionalProperties": false,
          "properties": {
            "query": { "type": "string" },
            "depth": { "type": "string", "enum": ["shallow", "standard", "deep"] },
            "sources_found": { "type": "integer", "minimum": 0 },
            "sources_fetched": { "type": "integer", "minimum": 0 },
            "search_queries_used": { "type": "integer", "minimum": 1 },
            "timestamp": { "type": "string", "description": "ISO 8601 datetime" },
            "duration_estimate": { "type": "string", "examples": ["~1 min", "~3 min", "~8 min"] },
            "search_status": {
              "type": "string",
              "enum": ["OK", "UNAVAILABLE"],
              "description": "Присутствует только при UNAVAILABLE — WebSearch недоступен"
            }
          }
        },
        "key_findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["finding", "confidence", "sources", "contested"],
            "additionalProperties": false,
            "properties": {
              "finding": { "type": "string", "description": "Краткое утверждение (< 120 символов)" },
              "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
              "sources": {
                "type": "array",
                "items": { "type": "string", "format": "uri" },
                "minItems": 1
              },
              "contested": { "type": "boolean" },
              "synthesis": {
                "type": "boolean",
                "description": "true = вывод агента (синтез), не прямая цитата источника"
              }
            }
          }
        },
        "detailed_findings": {
          "type": "object",
          "description": "Ключ = область исследования или тема",
          "additionalProperties": {
            "type": "object",
            "required": ["summary", "key_points", "sources", "contested_points"],
            "additionalProperties": false,
            "properties": {
              "summary": { "type": "string" },
              "key_points": {
                "type": "array",
                "items": { "type": "string" }
              },
              "sources": {
                "type": "array",
                "items": { "type": "string", "format": "uri" }
              },
              "contested_points": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["topic", "position_a", "position_b", "resolution"],
            "additionalProperties": false,
            "properties": {
              "topic": { "type": "string" },
              "position_a": {
                "type": "object",
                "required": ["claim", "source"],
                "properties": {
                  "claim": { "type": "string" },
                  "source": { "type": "string", "format": "uri" }
                }
              },
              "position_b": {
                "type": "object",
                "required": ["claim", "source"],
                "properties": {
                  "claim": { "type": "string" },
                  "source": { "type": "string", "format": "uri" }
                }
              },
              "resolution": {
                "type": "string",
                "enum": ["unclear", "position_a_stronger", "position_b_stronger"]
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Что найти не удалось"
        },
        "sources": {
          "description": "Массив источников (JSON) или TOON-ссылка '<<TOON:sources>>' если >= 8 источников",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["url", "title", "type", "reliability", "fetched", "key_insights"],
                "additionalProperties": false,
                "properties": {
                  "url": { "type": "string", "format": "uri" },
                  "title": { "type": "string" },
                  "type": {
                    "type": "string",
                    "enum": ["official_docs", "research", "article", "blog", "github", "other"]
                  },
                  "reliability": { "type": "string", "enum": ["high", "medium", "low"] },
                  "fetched": { "type": "boolean" },
                  "key_insights": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            },
            {
              "type": "string",
              "const": "<<TOON:sources>>",
              "description": "TOON-ссылка используется когда sources >= 8"
            }
          ]
        },
        "recommendations": {
          "type": "object",
          "required": ["for_caller", "action_items", "confidence_overall"],
          "additionalProperties": false,
          "properties": {
            "for_caller": { "type": "string", "enum": ["researcher", "user"] },
            "action_items": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "further_research_needed": {
              "type": "array",
              "items": { "type": "string" }
            },
            "confidence_overall": { "type": "string", "enum": ["high", "medium", "low"] }
          }
        }
      }
    }
  }
}
