      "mcp__iwiki-local__wiki_code_publish_begin",
      "mcp__iwiki-local__wiki_code_publish_batch",
      "mcp__iwiki-local__wiki_code_publish_finalize",
      "mcp__iwiki-local__wiki_code_publish_abort",
      "mcp__iwiki-local__wiki_list_domain_grants",
      "mcp__iwiki-remote__wiki_status",
      "mcp__iwiki-remote__wiki_bind",
      "mcp__iwiki-remote__wiki_search",
      "mcp__iwiki-remote__wiki_related",
      "mcp__iwiki-remote__wiki_read_page",
      "mcp__iwiki-remote__wiki_list_domains",
      "mcp__iwiki-remote__wiki_list_pages",
