      "mcp__iwiki-remote__wiki_delete_section",
      "mcp__iwiki-remote__wiki_index",
      "mcp__iwiki-remote__wiki_lint",
      "mcp__iwiki-remote__wiki_spec_search",
      "mcp__iwiki-remote__wiki_spec_context",
      "mcp__iwiki-remote__wiki_spec_resolve",
      "mcp__iwiki-remote__wiki_code_status",
      "mcp__iwiki-remote__wiki_code_search",
      "mcp__iwiki-remote__wiki_code_context",
      "mcp__iwiki-remote__wiki_sync",
      "mcp__iwiki-remote__wiki_code_index",
      "mcp__iwiki-remote__wiki_code_publish_begin",
      "mcp__iwiki-remote__wiki_code_publish_batch",
      "mcp__iwiki-remote__wiki_code_publish_finalize",
      "mcp__iwiki-remote__wiki_code_publish_abort",
      "mcp__iwiki-remote__wiki_list_domain_grants",
