{
  "cleanupPeriodDays": 7,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "MultiEdit",
      "Write",
      "Glob",
      "Grep",
      "LS",
      "WebFetch",
      "WebSearch",
      "Task",
      "TodoRead",
      "TodoWrite",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(gh:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(tree:*)",
      "Bash(cd:*)",
      "Bash(bash -n:*)",
      "Bash(ssh:*)",
      "Bash(source:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env.local)",
      "Read(**/secrets/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.kube/config)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/.credentials)",
      "Read(**/.credentials.json)",
      "Read(**/credentials.json)",
      "Read(**/credentials.yaml)",
      "Read(**/credentials.yml)",
      "Read(**/.token)",
      "Read(**/.token.*)",
      "Read(**/token.json)",
      "Read(**/token.txt)",
      "Read(**/access_token.*)",
      "Read(**/refresh_token.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.ssh/**)",
      "Edit(**/.aws/**)",
      "Edit(**/secrets/**)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)"
    ],
    "ask": [
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(truncate:*)",
      "Bash(shred:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)"
    ],
    "defaultMode": "default"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "timeout 0.5 $CLAUDE_CONFIG_DIR/scripts/claude-statusline.sh || true"
  },
  "language": "Russian",
  "alwaysThinkingEnabled": true,
  "plansDirectory": ".claude/plans",
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true
}
