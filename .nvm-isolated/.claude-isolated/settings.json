      "Bash(rmdir:*)",
      "Bash(truncate:*)",
      "Bash(shred:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)"
    ],
    "deny": [
      "Read(**/.env.local)",
      "Read(**/secrets/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.kube/config)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/.credentials)",
      "Read(**/.credentials.json)",
      "Read(**/credentials.json)",
      "Read(**/credentials.yaml)",
      "Read(**/credentials.yml)",
      "Read(**/.token)",
      "Read(**/.token.*)",
      "Read(**/token.json)",
      "Read(**/token.txt)",
      "Read(**/access_token.*)",
      "Read(**/refresh_token.*)",
      "Edit(**/.env)",
      "Edit(**/.ssh/**)",
      "Edit(**/.aws/**)",
      "Edit(**/secrets/**)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)"
    ],
    "ask": [
      "Read(**/.env)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "mcp__iwiki__wiki_delete_page",
      "mcp__iwiki__wiki_create_domain",
      "mcp__iwiki__wiki_set_domain_grant",
      "mcp__iwiki__wiki_revoke_domain_grant",
      "mcp__iwiki-local__wiki_delete_page",
      "mcp__iwiki-local__wiki_create_domain",
      "mcp__iwiki-local__wiki_set_domain_grant",
      "mcp__iwiki-local__wiki_revoke_domain_grant",
      "mcp__iwiki-remote__wiki_delete_page",
      "mcp__iwiki-remote__wiki_create_domain",
      "mcp__iwiki-remote__wiki_set_domain_grant",
      "mcp__iwiki-remote__wiki_revoke_domain_grant"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_CONFIG_DIR/hooks/block-secrets.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_CONFIG_DIR/hooks/redact-secrets.py\""
          }
        ]
      },
      {
        "matcher": "Skill|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_CONFIG_DIR/hooks/chain-gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_CONFIG_DIR/hooks/chain-gate.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/hooks/caveman-activate.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/hooks/iwiki-remote-scope.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/hooks/caveman-mode-tracker.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/hooks/caveman-stats-stop.js\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_CONFIG_DIR/hooks/cache-report.py\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/hooks/caveman-cleanup.js\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_CONFIG_DIR/scripts/claude-statusline.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "loen@iclaude": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "iclaude": {
      "source": {
        "source": "directory",
        "path": "/home/ikeniborn/Documents/Project/iclaude"
      }
    }
  },
  "language": "Russian",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "plansDirectory": ".claude/plans",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "skipDangerousModePermissionPrompt": true
}
