# gitignore
HEAD
.cache
# v* - commented out to allow committing Node.js versions to git
alias

# For testing
test/bak
.urchin.log
.urchin_stdout
test/**/test_output

node_modules/
# Allow Node.js built-in modules in versions directory
!versions/node/*/lib/node_modules/
# Allow npm's internal node_modules (including dependencies like graceful-fs)
!versions/node/*/lib/node_modules/*/node_modules/
# Allow nested node_modules for minipass@3 compatibility shims
# (minipass-pipeline, minipass-flush, etc. require minipass@^3 but npm bundles minipass@7)
!versions/node/*/lib/node_modules/*/node_modules/*/node_modules/
# Allow globally installed npm packages (including Claude Code)
!npm-global/lib/node_modules/
npm-debug.log

.DS_Store
current
/default-packages

# Only apps should have lockfiles
npm-shrinkwrap.json
package-lock.json
yarn.lock
.nvm-isolated/npm-global/lib/node_modules/@anthropic-ai/claude-code-linux-x64/
