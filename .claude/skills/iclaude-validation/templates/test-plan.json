{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iclaude Test Plan",
  "description": "Structured test plan for validating iclaude.sh changes",
  "type": "object",
  "required": ["feature", "testCases"],
  "properties": {
    "feature": {
      "type": "string",
      "description": "Name of the feature being tested"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what is being tested"
    },
    "version": {
      "type": "string",
      "description": "Version of iclaude.sh being tested",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "author": {
      "type": "string",
      "description": "Person who created the test plan"
    },
    "date": {
      "type": "string",
      "description": "Date test plan was created (ISO 8601)",
      "format": "date"
    },
    "dependencies": {
      "type": "array",
      "description": "Features or skills this test depends on",
      "items": {
        "type": "string"
      }
    },
    "testCases": {
      "type": "array",
      "description": "List of test cases to execute",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "steps", "expectedResult"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique test case identifier",
            "pattern": "^TC\\d{3}$"
          },
          "name": {
            "type": "string",
            "description": "Brief test case name"
          },
          "type": {
            "type": "string",
            "description": "Type of test",
            "enum": ["unit", "integration", "end-to-end", "regression", "performance", "security"]
          },
          "priority": {
            "type": "string",
            "description": "Test priority level",
            "enum": ["critical", "high", "medium", "low"],
            "default": "medium"
          },
          "prerequisites": {
            "type": "array",
            "description": "Conditions that must be met before running test",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "description": "Ordered list of test steps",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["action"],
              "properties": {
                "action": {
                  "type": "string",
                  "description": "Command or action to perform"
                },
                "expected": {
                  "type": "string",
                  "description": "Expected behavior for this step"
                }
              }
            }
          },
          "expectedResult": {
            "type": "string",
            "description": "Overall expected result of the test"
          },
          "actualResult": {
            "type": "string",
            "description": "Actual result observed (filled during execution)"
          },
          "status": {
            "type": "string",
            "description": "Test execution status",
            "enum": ["not_run", "passed", "failed", "blocked", "skipped"]
          },
          "failureReason": {
            "type": "string",
            "description": "Reason for failure (if status is 'failed')"
          },
          "executionTime": {
            "type": "number",
            "description": "Time taken to execute test (in seconds)"
          },
          "notes": {
            "type": "string",
            "description": "Additional observations or comments"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "Test environment details",
      "properties": {
        "os": {
          "type": "string",
          "description": "Operating system (Linux, macOS, Windows)"
        },
        "shell": {
          "type": "string",
          "description": "Shell being used (bash, zsh)"
        },
        "nodeVersion": {
          "type": "string",
          "description": "Node.js version"
        },
        "claudeCodeVersion": {
          "type": "string",
          "description": "Claude Code CLI version"
        },
        "installMode": {
          "type": "string",
          "description": "Installation mode being tested",
          "enum": ["isolated", "system"]
        },
        "proxyEnabled": {
          "type": "boolean",
          "description": "Whether proxy is configured"
        },
        "routerEnabled": {
          "type": "boolean",
          "description": "Whether router is installed"
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Test execution summary",
      "properties": {
        "totalTests": {
          "type": "integer",
          "description": "Total number of test cases"
        },
        "passed": {
          "type": "integer",
          "description": "Number of tests that passed"
        },
        "failed": {
          "type": "integer",
          "description": "Number of tests that failed"
        },
        "blocked": {
          "type": "integer",
          "description": "Number of tests that were blocked"
        },
        "skipped": {
          "type": "integer",
          "description": "Number of tests that were skipped"
        },
        "passRate": {
          "type": "number",
          "description": "Pass rate percentage (0-100)",
          "minimum": 0,
          "maximum": 100
        },
        "totalExecutionTime": {
          "type": "number",
          "description": "Total time for all tests (in seconds)"
        }
      }
    },
    "issues": {
      "type": "array",
      "description": "Issues discovered during testing",
      "items": {
        "type": "object",
        "required": ["id", "severity", "description"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Issue identifier",
            "pattern": "^ISS\\d{3}$"
          },
          "severity": {
            "type": "string",
            "description": "Issue severity",
            "enum": ["critical", "major", "minor", "trivial"]
          },
          "description": {
            "type": "string",
            "description": "Detailed issue description"
          },
          "testCaseId": {
            "type": "string",
            "description": "Test case that discovered this issue"
          },
          "reproducible": {
            "type": "boolean",
            "description": "Whether issue is consistently reproducible"
          },
          "workaround": {
            "type": "string",
            "description": "Temporary workaround (if available)"
          },
          "status": {
            "type": "string",
            "description": "Issue resolution status",
            "enum": ["open", "in_progress", "resolved", "closed", "wont_fix"]
          }
        }
      }
    }
  }
}
