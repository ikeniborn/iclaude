{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iclaude Security Checklist",
  "description": "Security validation checklist for iclaude.sh production deployment",
  "type": "object",
  "required": [
    "proxy",
    "authentication",
    "credentials",
    "environment",
    "testing"
  ],
  "properties": {
    "proxy": {
      "type": "object",
      "description": "Proxy configuration security checks",
      "required": [
        "protocol",
        "trusted_server",
        "certificate_validation",
        "domain_preservation"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "enum": ["https", "http", "socks5"],
          "description": "Proxy protocol (must be https for production)",
          "default": "https"
        },
        "trusted_server": {
          "type": "boolean",
          "description": "Is the proxy server trusted and managed by your organization?",
          "default": false
        },
        "certificate_validation": {
          "type": "object",
          "required": ["enabled", "method"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Is TLS certificate validation enabled?",
              "default": true
            },
            "method": {
              "type": "string",
              "enum": ["proxy-ca", "system-ca", "insecure"],
              "description": "Certificate validation method (never use insecure in production)"
            },
            "ca_path": {
              "type": "string",
              "description": "Path to proxy CA certificate (required if method=proxy-ca)",
              "pattern": "^/.*\\.pem$"
            }
          }
        },
        "domain_preservation": {
          "type": "boolean",
          "description": "Are domain names preserved in proxy URL (required for OAuth)?",
          "default": true
        },
        "test_passed": {
          "type": "boolean",
          "description": "Has proxy configuration passed --test validation?",
          "default": false
        }
      }
    },
    "authentication": {
      "type": "object",
      "description": "OAuth and authentication security checks",
      "required": [
        "token_refresh_enabled",
        "token_expiration_monitored",
        "manual_login_tested"
      ],
      "properties": {
        "token_refresh_enabled": {
          "type": "boolean",
          "description": "Is automatic OAuth token refresh enabled?",
          "default": true
        },
        "token_expiration_monitored": {
          "type": "boolean",
          "description": "Is token expiration being monitored?",
          "default": false
        },
        "refresh_threshold_days": {
          "type": "number",
          "description": "Token refresh threshold in days",
          "minimum": 1,
          "maximum": 30,
          "default": 7
        },
        "manual_login_tested": {
          "type": "boolean",
          "description": "Has manual /login been tested as fallback?",
          "default": false
        },
        "token_location": {
          "type": "string",
          "description": "Location of .credentials.json file",
          "pattern": "^/.*\\.credentials\\.json$"
        }
      }
    },
    "credentials": {
      "type": "object",
      "description": "Credential storage security checks",
      "required": [
        "file_permissions",
        "git_excluded",
        "isolated_config"
      ],
      "properties": {
        "file_permissions": {
          "type": "string",
          "enum": ["600", "640", "644", "other"],
          "description": "Permissions of .claude_proxy_credentials file (must be 600)",
          "default": "600"
        },
        "git_excluded": {
          "type": "boolean",
          "description": "Is .claude_proxy_credentials excluded from git?",
          "default": false
        },
        "isolated_config": {
          "type": "boolean",
          "description": "Is isolated config enabled for project-specific credentials?",
          "default": false
        },
        "credential_files": {
          "type": "array",
          "description": "List of credential files to protect",
          "items": {
            "type": "object",
            "required": ["path", "permissions"],
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute path to credential file"
              },
              "permissions": {
                "type": "string",
                "pattern": "^[0-7]{3}$",
                "description": "File permissions in octal format"
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "Environment configuration security checks",
      "required": [
        "tasks_system_enabled",
        "isolated_environment",
        "symlinks_valid"
      ],
      "properties": {
        "tasks_system_enabled": {
          "type": "boolean",
          "description": "Is CLAUDE_CODE_ENABLE_TASKS=true?",
          "default": true
        },
        "isolated_environment": {
          "type": "object",
          "required": ["enabled", "lockfile_committed"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Is isolated environment (.nvm-isolated/) being used?",
              "default": false
            },
            "lockfile_committed": {
              "type": "boolean",
              "description": "Is .nvm-isolated-lockfile.json committed to git?",
              "default": false
            },
            "lockfile_version": {
              "type": "string",
              "description": "Claude Code version from lockfile"
            }
          }
        },
        "symlinks_valid": {
          "type": "boolean",
          "description": "Have symlinks been verified with --check-isolated?",
          "default": false
        },
        "environment_variables": {
          "type": "object",
          "description": "Required environment variables",
          "properties": {
            "HTTPS_PROXY": {
              "type": "string",
              "pattern": "^https://.*$"
            },
            "HTTP_PROXY": {
              "type": "string",
              "pattern": "^https?://.*$"
            },
            "NO_PROXY": {
              "type": "string",
              "description": "Comma-separated list of domains to bypass proxy"
            },
            "NODE_EXTRA_CA_CERTS": {
              "type": "string",
              "description": "Path to CA certificate bundle (optional)"
            },
            "CLAUDE_CODE_ENABLE_TASKS": {
              "type": "string",
              "enum": ["true", "false"],
              "default": "true"
            }
          }
        }
      }
    },
    "testing": {
      "type": "object",
      "description": "Testing and validation checks",
      "required": [
        "proxy_test_passed",
        "oauth_refresh_tested",
        "update_verified"
      ],
      "properties": {
        "proxy_test_passed": {
          "type": "boolean",
          "description": "Has ./iclaude.sh --test passed?",
          "default": false
        },
        "oauth_refresh_tested": {
          "type": "boolean",
          "description": "Has OAuth token refresh been tested?",
          "default": false
        },
        "update_verified": {
          "type": "boolean",
          "description": "Has lockfile been verified after --update?",
          "default": false
        },
        "symlink_repair_tested": {
          "type": "boolean",
          "description": "Has --repair-isolated been tested after git operations?",
          "default": false
        },
        "test_results": {
          "type": "array",
          "description": "Detailed test results",
          "items": {
            "type": "object",
            "required": ["test_name", "status"],
            "properties": {
              "test_name": {
                "type": "string",
                "description": "Name of test executed"
              },
              "status": {
                "type": "string",
                "enum": ["passed", "failed", "skipped"],
                "description": "Test execution status"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp of test execution"
              },
              "error_message": {
                "type": "string",
                "description": "Error message if test failed"
              }
            }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "description": "Deployment environment information",
      "properties": {
        "environment_type": {
          "type": "string",
          "enum": ["development", "staging", "production"],
          "description": "Deployment environment type"
        },
        "deployment_date": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of deployment"
        },
        "responsible_person": {
          "type": "string",
          "description": "Person responsible for this deployment"
        },
        "approval_required": {
          "type": "boolean",
          "description": "Does deployment require security approval?",
          "default": false
        },
        "approved_by": {
          "type": "string",
          "description": "Person who approved deployment (if approval required)"
        }
      }
    },
    "monitoring": {
      "type": "object",
      "description": "Post-deployment monitoring",
      "properties": {
        "token_expiration_alerts": {
          "type": "boolean",
          "description": "Are token expiration alerts configured?",
          "default": false
        },
        "proxy_connection_monitoring": {
          "type": "boolean",
          "description": "Is proxy connection health monitored?",
          "default": false
        },
        "symlink_integrity_checks": {
          "type": "boolean",
          "description": "Are symlinks checked regularly?",
          "default": false
        },
        "alert_contacts": {
          "type": "array",
          "description": "List of contacts for security alerts",
          "items": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  }
}
